{"parentUuid":"d3ba7d51-6163-4f60-a514-1008a6d8b33e","isSidechain":false,"message":{"model":"claude-sonnet-5-5","id":"msg_011CfwshDLRWn6ep6wukL1Rf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01X8EjVkQTuftds65CHu556X","name":"Write","input":{"file_path":"C:\\Users\\mdhat\\AppData\\Local\\Temp\\claude\\d--storybound\\531bd6f2-4e0c-4a05-a2e1-9f902bd0eeb6\\scratchpad\\pick_eval_spans.py","content":"\"\"\"Pick 20 judge-verdict GUARDRAIL spans (10 violations, 10 passes, different promises and stories) from recent create-storybook traces for the human evaluation.\"\"\"\nimport json\nimport random\nimport re\nimport sys\nimport time\n\nsys.path.insert(0, r\"D:\\storybound\\scripts\")\nsys.path.insert(0, r\"D:\\storybound\\src\")\nimport neatlogs_mcp as m  # noqa: E402\n\n\ndef call(name, args):\n    for _ in range(4):\n        r = m.rpc(\"tools/call\", {\"name\": name, \"arguments\": args})\n        t = \"\".join(c.get(\"text\", \"\") for c in r.get(\"result\", {}).get(\"content\", []))\n        if \"rate\" in t.lower()[:80] or \"429\" in t[:80]:\n            time.sleep(60)\n            continue\n        return t\n    return t\n\n\nfound = {\"violation\": [], \"pass\": []}\nseen_traces = set()\nfor q in ('\"Verdict By: judge\"', '\"Verdict By: both\" \"Judge Status\"'):\n    for off in (0, 20):\n        d = json.loads(call(\"search_traces\", {\"query\": q, \"limit\": 20, \"offset\": off, \"date_from\": \"2026-10-12T04:00:00Z\", \"workflow_name\": \"create-storybook\"}))\n        for x in d.get(\"results\", []):\n            if x[\"trace_id\"] in seen_traces or (x.get(\"span_count\") or 0) < 100:\n                continue\n            seen_traces.add(x[\"trace_id\"])\nprint(\"candidate traces\", len(seen_traces), flush=True)\nrandom.seed(7)\nfor tid in list(seen_traces)[:14]:\n    off = 0\n    spans = []\n    while True:\n        j = json.loads(call(\"get_trace_context\", {\"trace_id\": tid, \"offset\": off}))\n        if \"spans\" not in j:\n            break\n        spans += j[\"spans\"]\n        if j.get(\"next_offset\") in (None, off) or len(spans) >= j[\"span_count\"]:\n            break\n        off = j[\"next_offset\"]\n    for s in spans:\n        if s[\"type\"] != \"GUARDRAIL\" or not s[\"name\"].startswith(\"verify:\"):\n            continue\n        out = s.get(\"output_value\") or \"\"\n        if \"Verdict By: judge\" not in out and \"Verdict By: both\" not in out:\n            continue\n        st = re.search(r\"Status: (\\w+)\", out)\n        if not st or st.group(1) not in (\"violation\", \"pass\"):\n            continue\n        found[st.group(1)].append({\"trace_id\": tid, \"span_id\": s[\"span_id\"], \"promise\": s[\"name\"][7:], \"status\": st.group(1), \"input\": (s.get(\"input_value\") or \"\")[:400], \"output\": out[:500]})\n    print(tid[:8], {k: len(v) for k, v in found.items()}, flush=True)\n    if min(len(found[\"violation\"]), len(found[\"pass\"])) >= 40:\n        break\n\n\ndef spread(items, n):\n    by = {}\n    for it in items:\n        by.setdefault((it[\"promise\"], it[\"trace_id\"]), it)\n    pool = list(by.values())\n    random.shuffle(pool)\n    out, seen_p = [], {}\n    for it in pool:  # at most 3 per promise so the sample is varied\n        if seen_p.get(it[\"promise\"], 0) < 3:\n            out.append(it)\n            seen_p[it[\"promise\"]] = seen_p.get(it[\"promise\"], 0) + 1\n        if len(out) == n:\n            break\n    return out\n\n\npick = {\"violation\": spread(found[\"violation\"], 10), \"pass\": spread(found[\"pass\"], 10)}\njson.dump(pick, open(r\"D:\\storybound\\evidence\\neatlogs\\review-3\\eval_sample_20.json\", \"w\", encoding=\"utf-8\"), indent=1)\nprint({k: len(v) for k, v in pick.items()}, [p[\"promise\"] for p in pick[\"violation\"]])\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3688,"cache_read_input_tokens":9353