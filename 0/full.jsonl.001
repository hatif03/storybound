format"]},{"properties":{"grain":{"not":{"type":"null"}}},"required":["grain"]},{"properties":{"window":{"not":{"type":"null"}}},"required":["window"]},{"properties":{"show_empty_members":{"not":{"type":"null"}}},"required":["show_empty_members"]},{"properties":{"formula_hidden":{"not":{"type":"null"}}},"required":["formula_hidden"]},{"properties":{"formula_groups_hidden":{"not":{"type":"null"}}},"required":["formula_groups_hidden"]},{"properties":{"formula_breaks_hidden":{"not":{"type":"null"}}},"required":["formula_breaks_hidden"]},{"properties":{"hide_dimension_headers":{"not":{"type":"null"}}},"required":["hide_dimension_headers"]},{"properties":{"variables":{"minItems":1,"type":"array"}},"required":["variables"]},{"$ref":"#/$defs/schema86"},{"properties":{"sources":{"minItems":1,"type":"array"}},"required":["sources"]},{"properties":{"values":{"type":"object"}},"required":["values"]},{"$ref":"#/$defs/schema89"},{"$ref":"#/$defs/schema90"},{"$ref":"#/$defs/schema91"},{"$ref":"#/$defs/schema92"},{"properties":{"format_updates":{"type":"object"}},"required":["format_updates"]}],"properties":{}}],"properties":{"add_dimension_items":{"$ref":"#/$defs/add_dimension_items"},"based_on":{"$ref":"#/$defs/based_on"},"cell_updates":{"$ref":"#/$defs/cell_updates"},"column_updates":{"$ref":"#/$defs/column_updates"},"dimensions":{"description":"Settings and members of the named dimensions. A setting is the dimension's wherever it is read and needs no target; member edits go through a table that shows the dimension. Omitted settings are preserved; delete selects these entities explicitly.","items":{"additionalProperties":false,"anyOf":[{"required":["add_items"]},{"required":["currency"]},{"required":["data_type"]},{"required":["decimal_places"]},{"required":["format"]},{"required":["name"]},{"required":["preferred_time_property"]},{"required":["remove_items"]},{"required":["rename_items"]},{"required":["replace_items"]}],"if":{"properties":{"replace_items":{"type":"array"}},"re