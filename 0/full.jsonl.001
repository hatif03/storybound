val drops an occurrence and subtree, never its objects; an object's home-table node stays until the object is deleted. Moves retain children. Destinations use side rows/columns, optional parent, and before/after sibling references; omission appends. Inserts use the shared node grammar, and the same update may write the cells of the inserted rows or columns with cell_updates or values.","properties":{"insert":{"items":{"additionalProperties":false,"not":{"required":["before","after"]},"properties":{"after":{"$ref":"#/$defs/address"},"before":{"$ref":"#/$defs/address"},"node":{"$ref":"#/$defs/saved_table_node"},"parent":{"$ref":"#/$defs/address"},"side":{"$ref":"#/$defs/schema130"}},"required":["side","node"],"type":"object"},"maxItems":10000,"type":["null","array"]},"move":{"items":{"additionalProperties":false,"not":{"required":["before","after"]},"properties":{"after":{"$ref":"#/$defs/address"},"before":{"$ref":"#/$defs/address"},"parent":{"$ref":"#/$defs/address"},"side":{"$ref":"#/$defs/schema130"},"target":{"$ref":"#/$defs/address"}},"required":["side","target"],"type":"object"},"maxItems":10000,"type":["null","array"]},"remove":{"items":{"$ref":"#/$defs/address"},"maxItems":10000,"type":["null","array"]}},"type":["null","object"]},"target":{"$ref":"#/$defs/target"},"values":{"$ref":"#/$defs/values"},"variables":{"description":"Settings of the named variables: name, data_type, aggregation_function, preferred_time_property, format, decimal_places, currency, and default_formulas, the variable's own Actuals and Forecast rules. A setting is the variable's wherever it is read, so it lands on every variable named here, placed on this table or not, and needs no target. Omitted settings are preserved; delete selects these entities explicitly.","items":{"additionalProperties":false,"anyOf":[{"required":["aggregation_function"]},{"required":["currency"]},{"required":["data_type"]},{"required":["decimal_places"]},{"required":["default_formulas"]},{"required":["format"]},{"required":["name"]},{"required":["preferred_time_property"]}],"properties":{"aggregation_function":{"$ref":"#/$defs/schema28"},"currency":{"type":["string","null"]},"data_type":{"$ref":"#/$defs/propertyDataType"},"decimal_places":{"maximum":2147483647,"minimum":-2147483648,"type":["null","integer"]},"default_formulas":{"$ref":"#/$defs/propertyDefaultFormulas"},"format":{"$ref":"#/$defs/schema12"},"name":{"pattern":"\\S","type":"string"},"preferred_time_property":{"$ref":"#/$defs/address"},"target":{"$ref":"#/$defs/address"}},"required":["target"],"type":"object"},"maxItems":10000,"minItems":1,"type":"array"},"window":{"$ref":"#/$defs/window_2"}},"type":"object"},"update_calendar":{"additionalProperties":false,"allOf":[{"properties":{}}],"properties":{"calendar":{"additionalProperties":false,"anyOf":[{"properties":{"range":{"not":{"type":"null"}}},"required":["range"]},{"properties":{"granularity":{"not":{"type":"null"}}},"required":["granularity"]},{"properties":{"range_start":{"not":{"type":"null"}}},"required":["range_start"]},{"properties":{"range_end":{"not":{"type":"null"}}},"required":["range_end"]},{"properties":{"last_close":{"not":{"type":"null"}}},"required":["last_close"]}],"description":"Time defaults, Last close and named formula ranges of the scenario named by scenario, the current one when omitted; every table in that scenario shares them. These are separate from a table's grain/window display overrides.","properties":{"granularity":{"$ref":"#/$defs/schema1"},"last_close":{"$ref":"#/$defs/address"},"range":{"additionalProperties":false,"description":"Without target it creates; with target it updates. Bounds accept dates or date-reference targets. An empty string opens an endpoint; omission/null preserves an existing bound.","else":{"required":["name","start","end"]},"if":{"properties":{"target":{"type":"string"}},"required":["target"]},"properties":{"end":{"type":["string","null"]},"name":{"$ref":"#/$defs/address"},"start":{"type":["string","null"]},"target":{"$ref":"#/$defs/address"}},"then":{"anyOf":[{"$ref":"#/$defs/schema67"},{"$ref":"#/$defs/schema139"},{"$ref":"#/$defs/schema140"}]},"type":["null","object"]},"range_end":{"$ref":"#/$defs/address"},"range_start":{"$ref":"#/$defs/address"}},"type":["null","object"]},"scenario":{"$ref":"#/$defs/scenario"},"target":{"$ref":"#/$defs/schema99"}},"required":["calendar"],"type":"object"}},"required":[],"$defs":{"add_dimension_items":{"description":"Creates or reuses model-wide string members and attaches them to this table at their final parent. Explicit order is an ordinary sort update. values and cell_updates in this request may target new members.","items":{"additionalProperties":false,"properties":{"dimension":{"description":"The string dimension that breaks down this axis in the final layout, by readable property name or inspected saved-axis reference.","pattern":"\\S","type":"string"},"under":{"description":"A complete inspected parent row or column address in the final layout. Absent only for a root grouping. Sort and member filters stay unchanged unless explicitly updated.","pattern":"\\S","type":"string"},"value":{"description":"The new reusable dimension member.","pattern":"\\S","type":"string"}},"required":["dimension","value"],"type":"object"},"maxItems":50,"minItems":1,"type":["null","array"]},"address":{"pattern":"\\S","type":"string"},"axis_sort":{"additionalProperties":false,"description":"Order of this grouping axis's members: AXIS_ASC or AXIS_DESC by member, or MANUAL with manualOrdering naming the members that come first. The order belongs to the axis, so every parent using that axis shows it. Parent-local order requires an inspected axis owned by that complete item's breakdown; a rendered member address does not create such an owner.","if":{"properties":{"manualOrdering":{"minItems":1,"type":"array"}},"required":["manualOrdering"]},"properties":{"manualOrdering":{"items":{"type":"string"},"type":["null","array"]},"type":{"enum":["AXIS_ASC","AXIS_DESC","MANUAL"],"type":"string"}},"required":["type"],"then":{"properties":{"type":{"enum":["MANUAL"]}}},"type":["null","object"]},"based_on":{"description":"The as_of of the table read, or the change_log_id of the table write, this edit builds on. The receipt's changed_since_read issue names what others saved to the table after that point, and who; the edit is saved either way.","minimum":0,"type":["integer","null"]},"breakdownBranches":{"description":"Independent sibling paths. Each root-to-leaf path permits at most one branches fork. This explicit grouping keeps the complete published edit schema at its measured 14-level provider bound.","items":{"items":{"$ref":"#/$defs/breakdownLeaf"},"maxItems":10,"minItems":1,"type":"array"},"maxItems":10,"minItems":2,"type":"array"},"breakdownCondition":{"additionalProperties":false,"description":"Restricts this later dimension to an existing ancestor dimension and member on the same path.","properties":{"dimension":{"minLength":1,"type":"string"},"equals":{"type":"string"}},"required":["dimension","equals"],"type":"object"},"breakdownFilter":{"additionalProperties":false,"properties":{"include":{"description":"Selects visible child members. List order does not set display order; row_updates or column_updates with before/after order siblings. The parent measure population is unchanged.","items":{"type":"string"},"maxItems":10000,"minItems":1,"type":"array"}},"required":["include"],"type":"object"},"breakdownLeaf":{"additionalProperties":false,"allOf":[{"$ref":"#/$defs/layoutDimensionCondition"}],"oneOf":[{"$ref":"#/$defs/schema31"},{"properties":{"time":{"type":"string"}},"required":["time"]}],"properties":{"data_type":{"$ref":"#/$defs/nodeDataType"},"dimension":{"description":"A dimension by name or inspected reference. A name that matches one existing dimension reuses it; an unmatched name creates the dimension on this table.","minLength":1,"type":"string"},"filter":{"$ref":"#/$defs/breakdownFilter"},"items":{"$ref":"#/$defs/schema30"},"sort":{"$ref":"#/$defs/axis_sort"},"time":{"enum":["DAY","WEEK","MONTH","QUARTER","HALF","YEAR"],"type":"string"},"when":{"$ref":"#/$defs/breakdownCondition"}},"type":"object"},"breakdownNode":{"anyOf":[{"minLength":1,"type":"string"},{"$ref":"#/$defs/breakdownLeaf"},{"additionalProperties":false,"properties":{"branches":{"$ref":"#/$defs/breakdownBranches"}},"required":["branches"],"type":"object"}]},"cell_update":{"additionalProperties":false,"anyOf":[{"properties":{"format":{"not":{"type":"null"}}},"required":["format"]},{"properties":{"formula":{"not":{"type":"null"}}},"required":["formula"]},{"required":["value"]},{"$ref":"#/$defs/schema5"}],"description":"One rule at the selected cells' coordinates: formula or value saves it, clear_formula removes it. On a timeless row with one value column those coordinates are the row's own, so the edit writes or removes the row's formula.","not":{"anyOf":[{"allOf":[{"properties":{"formula":{"$ref":"#/$defs/schema8"}},"required":["formula"]},{"required":["value"]}]},{"allOf":[{"properties":{"formula":{"$ref":"#/$defs/schema8"}},"required":["formula"]},{"$ref":"#/$defs/schema10"}]},{"allOf":[{"required":["value"]},{"$ref":"#/$defs/schema10"}]}]},"properties":{"clear_formula":{"description":"Removes the rule saved at the selected cells' coordinates; with none saved there, the outcome is unchanged.","enum":[true,null],"type":["boolean","null"]},"columns":{"items":{"$ref":"#/$defs/address"},"minItems":1,"type":"array"},"format":{"anyOf":[{"$ref":"#/$defs/style"},{"type":"null"}]},"formula":{"pattern":"\\S","type":["string","null"]},"rows":{"items":{"$ref":"#/$defs/address"},"minItems":1,"type":"array"},"value":{"type":["string","number","boolean","null"]}},"required":["rows","columns"],"type":"object"},"cell_updates":{"description":"Cell rules and styles, including cells of rows, columns, members, or a table this same request creates.","items":{"$ref":"#/$defs/cell_update"},"maxItems":10000,"minItems":1,"type":["null","array"]},"childDefaults":{"description":"The rules the cells beneath the selected row or column inherit, one entry per breakdown dimension at any depth; a deeper level's entry is saved on the level above it (Total by Owner by Deal: the Deal entry is the rule on Total[Owner]). An axis row (Total[stage]) rules every member's children; a member row (Total[Discovery]) pins that member. Levels above the deepest without their own rule sum the level beneath in its ranges.","items":{"additionalProperties":false,"anyOf":[{"properties":{"formula":{"type":"string"}},"required":["formula"]},{"properties":{"actuals":{"not":{"type":"null"}}},"required":["actuals"]},{"properties":{"forecast":{"not":{"type":"null"}}},"required":["forecast"]},{"properties":{"clear":{"enum":[true]}},"required":["clear"]}],"properties":{"actuals":{"anyOf":[{"$ref":"#/$defs/defaultFormulaEdit"},{"type":"null"}],"description":"The Actuals rule these children inherit, as default_formulas.actuals takes it; omitted or null is unchanged."},"clear":{"description":"true removes the owned timeless child default; dated ranges clear through actuals or forecast.","type":"boolean"},"dimension":{"description":"A dimension of this row's breakdown at any depth, by name or reference (Employee ID#28); Date is not one.","pattern":"\\S","type":"string"},"forecast":{"anyOf":[{"$ref":"#/$defs/defaultFormulaEdit"},{"type":"null"}],"description":"The Forecast rule these children inherit, as default_formulas.forecast takes it; omitted or null is unchanged."},"formula":{"description":"The timeless rule these children inherit, in the item's formula grammar; dated tables use actuals and forecast.","type":"string"}},"required":["dimension"],"type":"object"},"maxItems":10,"minItems":1,"type":"array"},"clearAxisFormula":{"description":"Removes only the formula owned by this timeless selection. If none exists, the outcome is unchanged; inherited formulas remain.","type":"boolean"},"clearRangeFormula":{"description":"Removes only the formula owned by the selected business scope, Date grain, and range. With no owned formula, the outcome is unchanged. Inherited rules and exact cell overrides remain.","type":"boolean"},"column_updates":{"items":{"additionalProperties":false,"allOf":[{"not":{"allOf":[{"$ref":"#/$defs/schema149"},{"$ref":"#/$defs/schema10"}]}},{"not":{"allOf":[{"$ref":"#/$defs/schema149"},{"$ref":"#/$defs/schema151"}]}},{"not":{"allOf":[{"$ref":"#/$defs/schema10"},{"$ref":"#/$defs/schema151"}]}}],"anyOf":[{"properties":{"formula":{"not":{"type":"null"}}},"required":["formula"]},{"$ref":"#/$defs/schema5"},{"$ref":"#/$defs/schema6"},{"$ref":"#/$defs/schema7"},{"properties":{"format":{"not":{"type":"null"}}},"required":["format"]},{"properties":{"hidden":{"not":{"type":"null"}}},"required":["hidden"]},{"properties":{"role":{"not":{"type":"null"}}},"required":["role"]},{"properties":{"grain":{"not":{"type":"null"}}},"required":["grain"]},{"properties":{"sort":{"not":{"type":"null"}}},"required":["sort"]},{"properties":{"summary":{"not":{"type":"null"}}},"required":["summary"]},{"properties":{"members":{"not":{"type":"null"}}},"required":["members"]}],"properties":{"child_defaults":{"$ref":"#/$defs/childDefaults"},"clear_formula":{"$ref":"#/$defs/clearAxisFormula"},"columns":{"items":{"$ref":"#/$defs/address"},"minItems":1,"type":"array"},"default_formulas":{"$ref":"#/$defs/defaultFormulasEdit"},"format":{"anyOf":[{"$ref":"#/$defs/style"},{"type":"null"}]},"formula":{"description":"The selected column's own rule on a timeless table. Dated scopes use default_formulas. The rule its children inherit goes in child_defaults on this item. Omission preserves it; clear_formula removes its owned rule.","type":"string"},"grain":{"anyOf":[{"$ref":"#/$defs/schema1"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"hidden":{"$ref":"#/$defs/hidden"},"members":{"$ref":"#/$defs/schema3"},"role":{"$ref":"#/$defs/schema4"},"sort":{"anyOf":[{"$ref":"#/$defs/axis_sort"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"summary":{"$ref":"#/$defs/override"}},"required":["columns"],"type":"object"},"maxItems":10000,"minItems":1,"type":["null","array"]},"coordinate_selector":{"anyOf":[{"pattern":"\\S","type":"string"},{"additionalProperties":false,"properties":{"period_range":{"additionalProperties":false,"description":"Inclusive system Date interval at the saved axis grain, with bounds in that grain's period spelling, such as 2026-07 through 2026-09 for month.","properties":{"end":{"pattern":"\\S","type":"string"},"grain":{"enum":["day","week","month","quarter","year"],"type":"string"},"start":{"pattern":"\\S","type":"string"}},"required":["grain","start","end"],"type":"object"}},"required":["period_range"],"type":"object"}],"description":"A row or column: a ref with a # suffix, a name or path, a member by its path from its variable or axis dimension, one bracket per breakdown level, as a readback prints it (Revenue[West], Revenue[West][Enterprise], Employee ID[E-207]), a period such as 2026-03, a predicate such as `Employee ID` in any, or a period_range. The member with no value is spelled empty:None (Region[empty:None]). Backticks around a name are optional."},"create_columns":{"description":"Ordered columns using the create node grammar. An explicit empty list gives the table no column breakdown: with plain variable rows and window.granularity NO_GRANULARITY, a timeless scalar table whose one column is Value; with one plain dimension row, a member table, including an empty dimension. A dated table needs a Date column such as {\"time\": \"MONTH\"}.","items":{"allOf":[{"$ref":"#/$defs/saved_table_node"},{"$ref":"#/$defs/schema32"},{"not":{"required":["space"]}}]},"type":"array"},"create_comparison":{"anyOf":[{"additionalProperties":false,"description":"A table compares either across time (period_offset) or across scenarios (scenarios), never both; passing both is refused. Zero offset or an empty scenario list clears the comparison. Measures or layout alone select nothing.","properties":{"layout":{"description":"Scenario-comparison placement: COLUMNS or ROWS. Period comparison does not use this setting.","enum":["COLUMNS","ROWS"],"type":"string"},"measures":{"description":"Period comparison: CURRENT, COMPARISON_VALUE, DELTA, PERCENT. Scenario comparison: VALUE, DELTA, PERCENT. The mode-specific value names are not interchangeable.","items":{"enum":["CURRENT","COMPARISON_VALUE","VALUE","DELTA","PERCENT"],"type":"string"},"maxItems":50,"type":"array"},"period_offset":{"description":"Number of earlier periods in the saved Date grain to compare with; it needs a Date axis. Zero clears the comparison.","minimum":0,"type":"integer"},"scenarios":{"description":"Existing scenarios to compare with, other than the selected scenario. The list replaces the saved one; an empty list clears the comparison.","items":{"type":"string"},"maxItems":50,"type":"array"}},"type":"object"},{"type":"null"}]},"create_dimensions":{"description":"Settings of these dimensions, saved with the new table, or a new mapping into one: keys, items, and catch_all as edit_dimension_mappings map takes them, written in this change before the rows, so a rule reading the mapped dimension resolves in this call; the receipt's items entry for the dimension carries the mapping's facts. Targets use the declared name.","items":{"additionalProperties":false,"anyOf":[{"required":["catch_all"]},{"required":["currency"]},{"required":["data_type"]},{"required":["decimal_places"]},{"required":["format"]},{"required":["items"]},{"required":["keys"]},{"required":["name"]},{"required":["preferred_time_property"]}],"if":{"anyOf":[{"required":["keys"]},{"required":["items"]},{"required":["catch_all"]}]},"properties":{"catch_all":{"description":"Fixed target-wide fallback written beside the rows: records that no lookup into the target matches resolve to this item.","maxLength":1024,"minLength":1,"pattern":"\\S","type":"string"},"currency":{"type":["string","null"]},"data_type":{"$ref":"#/$defs/propertyDataType"},"decimal_places":{"maximum":2147483647,"minimum":-2147483648,"type":["null","integer"]},"format":{"$ref":"#/$defs/schema12"},"items":{"additionalProperties":{"maxLength":1024,"minLength":1,"pattern":"\\S","type":"string"},"description":"Single-key source values mapped to fixed reporting items. Nonempty items requires exactly one key.","maxProperties":10000,"minProperties":1,"propertyNames":{"maxLength":1024,"minLength":1,"pattern":"\\S","type":"string"},"type":"object"},"keys":{"description":"Source dimensions identifying this exact lookup.","items":{"maxLength":256,"minLength":1,"pattern":"\\S","type":"string"},"maxItems":50,"minItems":1,"type":"array"},"name":{"pattern":"\\S","type":"string"},"preferred_time_property":{"$ref":"#/$defs/address"},"target":{"$ref":"#/$defs/address"}},"required":["target"],"then":{"required":["keys","items"]},"type":"object"},"maxItems":10000,"minItems":1,"type":"array"},"create_rows":{"description":"At most 100 top-level rows; formulas, variables, formatting, columns, and propagated saved records do not count. Complete ordered layout: each variable entry is a calculated value, a parent with a breakdown included, and dimension children split it into member rows. Separate variables carry a statement's lines and subtotals; successive dimensions describe the levels of a categorical breakdown. Unrelated table settings are preserved. Extend larger tables with structure updates or reshape. Empty rows and columns create an empty table.","items":{"allOf":[{"$ref":"#/$defs/saved_table_node"},{"$ref":"#/$defs/schema32"}]},"maxItems":100,"type":"array"},"create_shape":{"anyOf":[{"properties":{"columns":{"maxItems":0},"rows":{"maxItems":0}}},{"properties":{"columns":{"minItems":1},"rows":{"minItems":1}}},{"properties":{"columns":{"maxItems":0},"rows":{"$ref":"#/$defs/schema152"}}},{"properties":{"columns":{"maxItems":0},"rows":{"items":{"not":{"$ref":"#/$defs/schema46"},"required":["variable"]},"minItems":1},"window":{"$ref":"#/$defs/schema153"}},"required":["window"]}]},"create_table":{"additionalProperties":false,"allOf":[{"$ref":"#/$defs/create_shape"}],"properties":{"cell_updates":{"$ref":"#/$defs/cell_updates"},"columns":{"$ref":"#/$defs/create_columns"},"comparison":{"$ref":"#/$defs/create_comparison"},"dimensions":{"$ref":"#/$defs/create_dimensions"},"name":{"$ref":"#/$defs/address"},"page":{"$ref":"#/$defs/schema24"},"readback":{"$ref":"#/$defs/readback"},"rows":{"$ref":"#/$defs/create_rows"},"show_empty_members":{"$ref":"#/$defs/schema26"},"sources":{"$ref":"#/$defs/sources"},"values":{"$ref":"#/$defs/values"},"variables":{"$ref":"#/$defs/create_variables"},"window":{"$ref":"#/$defs/create_window"}},"required":["name","rows","columns"],"type":"object"},"create_variables":{"description":"Settings of these variables, saved with the new table, placed on it or only read by its formulas: name, type, aggregation, source date, display format, and default_formulas. Targets use the declared name (net_revenue); name is the display name from this save (Net revenue).","items":{"additionalProperties":false,"anyOf":[{"required":["aggregation_function"]},{"required":["currency"]},{"required":["data_type"]},{"required":["decimal_places"]},{"required":["default_formulas"]},{"required":["format"]},{"required":["name"]},{"required":["preferred_time_property"]}],"properties":{"aggregation_function":{"$ref":"#/$defs/schema28"},"currency":{"type":["string","null"]},"data_type":{"$ref":"#/$defs/propertyDataType"},"decimal_places":{"maximum":2147483647,"minimum":-2147483648,"type":["null","integer"]},"default_formulas":{"$ref":"#/$defs/propertyDefaultFormulas"},"format":{"$ref":"#/$defs/schema12"},"name":{"pattern":"\\S","type":"string"},"preferred_time_property":{"$ref":"#/$defs/address"},"target":{"$ref":"#/$defs/address"}},"required":["target"],"type":"object"},"maxItems":10000,"minItems":1,"type":"array"},"create_window":{"anyOf":[{"additionalProperties":false,"description":"Saved display window controls visible periods; formulas can still read periods outside it. Bounds are absolute YYYY-MM-DD dates supplied together; relative date strings are not accepted.","properties":{"end":{"type":"string"},"granularity":{"description":"NO_GRANULARITY makes the table timeless: no reporting periods and no Date axis. Any other grain gives a table that creates a new variable a Date axis.","enum":["DAY","WEEK","MONTH","QUARTER","HALF","YEAR","NO_GRANULARITY"],"type":"string"},"start":{"type":"string"}},"type":"object"},{"type":"null"}]},"declarativeRangeDefault":{"anyOf":[{"pattern":"\\S","type":"string"},{"$ref":"#/$defs/inherit"},{"type":"null"}],"description":"Declarative range default: an expression sets the owned formula, {\"inherit\":true} removes its owned override, and null preserves it."},"defaultFormulaEdit":{"anyOf":[{"$ref":"#/$defs/declarativeRangeDefault"},{"additionalProperties":false,"minProperties":1,"properties":{"clear_formula":{"$ref":"#/$defs/clearRangeFormula"},"formula":{"$ref":"#/$defs/rangeFormula"}},"type":"object"}]},"defaultFormulaInitializer":{"anyOf":[{"$ref":"#/$defs/declarativeRangeDefault"},{"additionalProperties":false,"properties":{"formula":{"description":"Initial formula at this variable's final scope: its ancestors, the opposite axis and the table's Date grain. Breakdown children scope only their own cells. Each inheriting cell evaluates its own inputs; literals represent constants. Example: Revenue - COGS. Full grammar: build-model / Formula syntax.","type":"string"}},"required":["formula"],"type":"object"}]},"defaultFormulasEdit":{"additionalProperties":false,"description":"Actuals and Forecast defaults for the selected row's or column's own rule at its variable/breakdown scope. The rule its children inherit goes in child_defaults on the same item. Each supplied range sets formula or clears its owned rule; omission preserves it and cell overrides. New defaults include finer grains; existing rules retain their scope.","minProperties":1,"properties":{"actuals":{"$ref":"#/$defs/defaultFormulaEdit"},"forecast":{"$ref":"#/$defs/defaultFormulaEdit"}},"type":"object"},"defaultFormulasInitializer":{"additionalProperties":false,"description":"Actuals and Forecast formulas for this row's or column's own rule, saved with the layout. One entry per variable; on an existing variable they replace its saved defaults, as an update would.","minProperties":1,"properties":{"actuals":{"$ref":"#/$defs/defaultFormulaInitializer"},"forecast":{"$ref":"#/$defs/defaultFormulaInitializer"}},"type":"object"},"format":{"anyOf":[{"$ref":"#/$defs/style"},{"type":"null"}],"description":"Table-default style. More specific row, column and cell styles remain unchanged. Explicit indent changes require whole-row selection; reset clears all local table-default style fields.","not":{"properties":{"indent":{"not":{"type":"null"}}},"required":["indent"]}},"format_updates":{"additionalProperties":{"$ref":"#/$defs/style"},"description":"Style patches keyed by the refs a read's formatting.scopes prints: a row or column ref for a saved node's style, or a Formatting scope#hash ref for a style no coordinate names. Calculated row and column selections remain in their existing update fields.","maxProperties":10000,"minProperties":1,"type":"object"},"formula_breaks_hidden":{"anyOf":[{"items":{"$ref":"#/$defs/address"},"type":"array"},{"$ref":"#/$defs/inherit"},{"type":"null"}],"description":"Complete local list of hidden formula ranges, by name or inspected target. [] clears the list; {inherit:true} restores scenario inheritance for the whole list."},"formula_groups_hidden":{"anyOf":[{"$ref":"#/$defs/schema18"},{"$ref":"#/$defs/inherit"},{"type":"null"}],"description":"Complete local map from value-column group names or inspected references to hidden booleans. {} clears the map; {inherit:true} restores scenario inheritance for the whole map."},"formula_hidden":{"anyOf":[{"type":"boolean"},{"$ref":"#/$defs/inherit"},{"type":"null"}],"description":"Default visibility of formula columns. Group overrides and hidden ranges remain separate."},"grain":{"anyOf":[{"$ref":"#/$defs/schema1"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"hidden":{"description":"Hides or shows the saved axis the selection belongs to; a member row (Total[West]) names its axis, so every member of that level hides. The page hides every row and column beneath a hidden axis, whatever their own hidden says. A group's summary column hides with its group and stays when only levels beneath it hide.","type":["boolean","null"]},"hide_dimension_headers":{"anyOf":[{"type":"boolean"},{"$ref":"#/$defs/inherit"},{"type":"null"}],"description":"true leaves out the row naming the dimension above each group of dimension items, so items sit directly under their parent row; false shows it."},"include_edit_rules":{"description":"Adds the editing rules of the touched rows and columns to the readback: accepted actions, owned defaults with ownership and writability, and formula roles. Omission returns writability alone.","type":"boolean"},"inherit":{"additionalProperties":false,"properties":{"inherit":{"enum":[true],"type":"boolean"}},"required":["inherit"],"type":"object"},"layoutDimensionCondition":{"if":{"anyOf":[{"properties":{"when":{"type":"object"}},"required":["when"]},{"properties":{"filter":{"type":"object"}},"required":["filter"]},{"properties":{"items":{"type":"array"}},"required":["items"]}]},"then":{"$ref":"#/$defs/schema31"}},"name":{"pattern":"\\S","type":["string","null"]},"nodeDataType":{"description":"Type of the object this node declares or names. A new dimension's member type: STRING by default, DATETIME for members from the timeline; an existing dimension keeps its type. On a variable, its value type, saved as the variable's setting.","type":"string"},"nodeFormula":{"description":"A shared, grain-free formula with condition [], used only when this declaration creates a new variable. Dated defaults may inherit it. Same grammar and forms as default_formulas.actuals.formula.","type":"string"},"override":{"anyOf":[{"$ref":"#/$defs/summary"},{"$ref":"#/$defs/inherit"},{"type":"null"}],"description":"Null preserves"},"propertyDataType":{"enum":["STRING","INT","FLOAT","DATETIME","BOOL","UUID"],"type":"string"},"propertyDefaultFormulas":{"$ref":"#/$defs/savedDefaultFormulasEdit","description":"The variable's own Actuals and Forecast rules, saved with no placement."},"rangeFormula":{"description":"The reusable calculation for this range. Each matching cell evaluates the expression with its own inputs. Example: Revenue - COGS. Forms: `Net Revenue` (quoted name); Revenue carries the current row's dimensions, Date included; Revenue$[...] is absolute and names its own segment; Revenue[Region=\"West\"] reads West instead of the row's Region; Revenue[-1] is the previous period; Revenue[Region in any] spans every Region. Write ^ = <>; ** == != still parse. Full grammar: build-model skill, Formula syntax reference (inspect_skills instructions).","type":"string"},"read_presentation":{"additionalProperties":false,"properties":{"available":{"type":"boolean"},"message":{"type":"string"},"retryable":{"type":"boolean"}},"required":["available","retryable"],"type":"object"},"readback":{"additionalProperties":false,"description":"Calculate selected rows and columns after the edit commits, with values, formulas, and zero or empty members hidden by the display. An omitted side reads all top-level rows or all columns. Period selection verifies only those cells and leaves the display window unchanged. Selectors follow the read grammar; renamed variables or dimensions resolve by either name. Unresolved selectors appear in issues as readback_selector_unresolved with the nearest coordinates; other selections still read. also adds other tables read at the same change. Read failure preserves the saved edit.","properties":{"also":{"description":"Other saved tables to read at the same change, so the edit's effect downstream arrives with this receipt. Each entry's result is under readback_also in request order; a target or selector that does not resolve is an issue on that entry.","items":{"additionalProperties":false,"properties":{"columns":{"description":"Columns of that table. Omitted reads every column.","items":{"$ref":"#/$defs/coordinate_selector"},"minItems":1,"type":"array"},"rows":{"description":"Rows of that table, in the selector grammar above. Omitted reads every top-level row.","items":{"$ref":"#/$defs/coordinate_selector"},"minItems":1,"type":"array"},"target":{"description":"A table, as a read's target names one: a name, a ref, or an id.","pattern":"\\S","type":"string"}},"required":["target"],"type":"object"},"maxItems":3,"minItems":1,"type":["null","array"]},"columns":{"items":{"$ref":"#/$defs/coordinate_selector"},"minItems":1,"type":"array"},"depth":{"anyOf":[{"minimum":0,"type":"integer"},{"enum":["all"],"type":"string"}],"description":"Child levels to include under each selected row, or all, with the read's meaning: 1 adds each row's members, 2 their members. Omitted returns the selected rows alone."},"rows":{"items":{"$ref":"#/$defs/coordinate_selector"},"minItems":1,"type":"array"}},"type":["null","object"]},"reference_address":{"anyOf":[{"$ref":"#/$defs/address"},{"$ref":"#/$defs/schema20"}]},"row_updates":{"items":{"additionalProperties":false,"allOf":[{"not":{"allOf":[{"$ref":"#/$defs/schema149"},{"$ref":"#/$defs/schema10"}]}},{"not":{"allOf":[{"$ref":"#/$defs/schema149"},{"$ref":"#/$defs/schema151"}]}},{"not":{"allOf":[{"$ref":"#/$defs/schema10"},{"$ref":"#/$defs/schema151"}]}}],"anyOf":[{"properties":{"formula":{"not":{"type":"null"}}},"required":["formula"]},{"$ref":"#/$defs/schema5"},{"$ref":"#/$defs/schema6"},{"$ref":"#/$defs/schema7"},{"properties":{"breakdown":{"type":"array"}},"required":["breakdown"]},{"properties":{"format":{"not":{"type":"null"}}},"required":["format"]},{"properties":{"hidden":{"not":{"type":"null"}}},"required":["hidden"]},{"properties":{"role":{"not":{"type":"null"}}},"required":["role"]},{"properties":{"grain":{"not":{"type":"null"}}},"required":["grain"]},{"properties":{"sort":{"not":{"type":"null"}}},"required":["sort"]},{"properties":{"summary":{"not":{"type":"null"}}},"required":["summary"]},{"properties":{"members":{"not":{"type":"null"}}},"required":["members"]}],"if":{"properties":{"breakdown":{"type":"array"}},"required":["breakdown"]},"properties":{"breakdown":{"anyOf":[{"items":{"$ref":"#/$defs/saved_table_node"},"maxItems":1,"type":"array"},{"type":"null"}],"description":"Replace this one concrete row's item-owned breakdown with one saved root; [] removes its entry. Omission preserves it. This does not replace a shared configured breakdown."},"child_defaults":{"$ref":"#/$defs/childDefaults"},"clear_formula":{"$ref":"#/$defs/clearAxisFormula"},"default_formulas":{"$ref":"#/$defs/defaultFormulasEdit"},"format":{"anyOf":[{"$ref":"#/$defs/style"},{"type":"null"}]},"formula":{"description":"The selected row's own rule on a timeless table. Dated scopes use default_formulas. The rule its children inherit goes in child_defaults on this item. Omission preserves it; clear_formula removes its owned rule.","type":"string"},"grain":{"anyOf":[{"$ref":"#/$defs/schema1"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"hidden":{"$ref":"#/$defs/hidden"},"members":{"$ref":"#/$defs/schema3"},"role":{"$ref":"#/$defs/schema4"},"rows":{"items":{"$ref":"#/$defs/address"},"minItems":1,"type":"array"},"sort":{"anyOf":[{"$ref":"#/$defs/axis_sort"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"summary":{"$ref":"#/$defs/override"}},"required":["rows"],"then":{"properties":{"rows":{"maxItems":1}}},"type":"object"},"maxItems":10000,"minItems":1,"type":["null","array"]},"savedDefaultFormulaEdit":{"anyOf":[{"$ref":"#/$defs/declarativeRangeDefault"},{"additionalProperties":false,"minProperties":1,"properties":{"clear_formula":{"$ref":"#/$defs/clearRangeFormula"},"formula":{"anyOf":[{"$ref":"#/$defs/rangeFormula"},{"type":"null"}],"description":"A copied null reports no owned default and makes no change; clear_formula:true removes a default."},"range":{"$ref":"#/$defs/savedFormulaRangeEvidence","description":"Readback evidence on a retained node; ignored by formula writes."},"range_binding":{"description":"Read-only range binding evidence on a retained node.","enum":["explicit","implicit"],"type":"string"},"range_unavailable":{"description":"Read-only unavailable-range evidence on a retained node.","type":"string"}},"type":"object"}]},"savedDefaultFormulasEdit":{"additionalProperties":false,"description":"Actuals and Forecast rules of the selected row, column, or variable at its scope and Date grain. Each supplied range sets a formula or clears its owned rule; an omitted range stays unchanged. The rule a row's children inherit goes in child_defaults on the same item. Existing rules keep their saved scope; a new rule takes the selected scope and reaches finer grains.","minProperties":1,"properties":{"actuals":{"$ref":"#/$defs/savedDefaultFormulaEdit"},"forecast":{"$ref":"#/$defs/savedDefaultFormulaEdit"},"ranges":{"items":{"$ref":"#/$defs/savedFormulaEvidence"},"type":["array","null"]},"unbound":{"$ref":"#/$defs/savedFormulaEvidence"}},"type":"object"},"savedFormulaEvidence":{"description":"Inspection-only evidence on a retained node; copying it does not author formulas.","properties":{"formula":{"type":["null","string"]},"formula_unavailable":{"type":"string"},"range":{"$ref":"#/$defs/savedFormulaRangeEvidence"},"range_binding":{"type":"string"},"range_unavailable":{"type":"string"},"source_state":{"type":"string"}},"required":["formula"],"type":"object"},"savedFormulaRangeEvidence":{"description":"Readback evidence on a retained node: the range's reference, definition, and resolved bounds as a read returned them. Writes ignore it.","type":"object"},"saved_table_node":{"additionalProperties":false,"allOf":[{"if":{"anyOf":[{"not":{"$ref":"#/$defs/schema52"}},{"properties":{"new":{"$ref":"