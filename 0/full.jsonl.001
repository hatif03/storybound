Absence selects the current state.","oneOf":[{"$ref":"#/$defs/schema11"},{"$ref":"#/$defs/schema12"},{"$ref":"#/$defs/schema13"},{"$ref":"#/$defs/schema14"}],"properties":{"calendar_boundary":{"$ref":"#/$defs/schema7"},"change_log_id":{"description":"Exact or approximate changelog point. The backend resolves to this workspace's latest changelog at or before this ID.","minimum":0,"type":"integer"},"relative_duration":{"$ref":"#/$defs/schema10"},"timestamp":{"description":"Exact instant supplied by the user, runtime context, or a tool result, as RFC3339 or RFC3339Nano with a timezone.","type":"string"}},"type":"object"},"schema3":{"anyOf":[{"$ref":"#/$defs/readSection_list"},{"$ref":"#/$defs/readSection_subtree"}]},"schema6":{"enum":["start","end"],"type":"string"},"schema7":{"description":"A local calendar period boundary in the user's runtime timezone, for phrases such as \"yesterday\" or \"last month\"; UTC when no timezone is known.","properties":{"boundary":{"$ref":"#/$defs/schema6"},"offset":{"description":"0 is the current period, -1 the previous, 1 the next.","type":"integer"},"unit":{"$ref":"#/$defs/schema1"}},"required":["unit","offset","boundary"],"type":"object"},"schema8":{"enum":["ago","from_now"],"type":"string"},"schema9":{"enum":["minute","hour","day","week"],"type":"string"}},"additionalProperties":false,"description":"Fill exactly one action block: list, read, subtree. Fields beside the block apply to it: as_of_point."},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__cfoai__inspect_skills","description":"Input constraint: Provide parameters for exactly one of: (file) or (instructions) or (list) or (read).\n\nLists saved workspace skills and built-in Ari skills, or reads their published instructions and supporting files. Reading a skill does not activate it. Built-in skills expose only their published reference content and cannot be edited. An unknown name is reported without failing the call. read without sections lists the skills.","input_schema":{"type":"object","properties":{"_context":{"additionalProperties":false,"description":"Optional active scenario, page, and time zone.","properties":{"layerId":{"description":"Active scenario ID.","type":"string"},"pageId":{"description":"Active page ID.","type":"string"},"timeZone":{"description":"Time zone, such as America/New_York.","type":"string"},"utcOffset":{"description":"UTC offset, such as -04:00.","type":"string"}},"type":"object"},"file":{"additionalProperties":false,"properties":{"path":{"allOf":[{"pattern":"\\S","type":"string"}],"description":"Path relative to that skill, as its own text points at it, e.g. \"references/pricing.md\".","type":"string"},"target":{"allOf":[{"pattern":"\\S","type":"string"}],"description":"The built-in skill's name, exactly as skills reports it.","pattern":"\\S","type":"string"}},"required":["path","target"],"type":"object"},"instructions":{"additionalProperties":false,"properties":{"target":{"allOf":[{"anyOf":[{"$ref":"#/$defs/schema2"},{"contains":{"pattern":"\\S","type":"string"},"items":{},"type":"array"}]}],"description":"Skills to read, each named exactly as skills reports it. A name matching nothing does not fail the call: unmatched names are listed in a trailing unresolved entry with candidate skills this workspace holds.","items":{"pattern":"\\S","type":"string"},"maxItems":50,"minItems":1,"pattern":"\\S","type":["string","array"]}},"required":["target"],"type":"object"},"list":{"additionalProperties":false,"properties":{"query":{"$ref":"#/$defs/schema9"}},"type":"object"},"org_id":{"description":"Workspace ID or slug. Optional when you belong to one workspace. Otherwise, call list_orgs and choose an ID or slug. Numbers always identify workspace IDs.","type":["string","number"]},"read":{"additionalProperties":false,"properties":{"sections":{"description":"One read, several questions: each section holds one question's fields, and scope fields at the top level apply to every section. A kind can repeat, each section with its own fields; the answer then lists one result per section under sections, in request order.","items":{"$ref":"#/$defs/schema1"},"maxItems":10,"minItems":1,"type":"array"}},"type":"object"}},"required":[],"$defs":{"readSection_file":{"additionalProperties":false,"properties":{"path":{"description":"Path relative to that skill, as its own text points at it, e.g. \"references/pricing.md\".","type":"string"},"section":{"enum":["file"],"type":"string"},"target":{"description":"The built-in skill's name, exactly as skills reports it.","pattern":"\\S","type":"string"}},"required":["section","path","target"],"type":"object"},"readSection_instructions":{"additionalProperties":false,"properties":{"section":{"enum":["instructions"],"type":"string"},"target":{"description":"Skills to read, each named exactly as skills reports it. A name matching nothing does not fail the call: unmatched names are listed in a trailing unresolved entry with candidate skills this workspace holds.","items":{"pattern":"\\S","type":"string"},"maxItems":50,"minItems":1,"pattern":"\\S","type":["string","array"]}},"required":["section","target"],"type":"object"},"readSection_list":{"additionalProperties":false,"properties":{"query":{"$ref":"#/$defs/schema9"},"section":{"enum":["list"],"type":"string"}},"required":["section"],"type":"object"},"schema1":{"anyOf":[{"$ref":"#/$defs/readSection_list"},{"$ref":"#/$defs/readSection_instructions"},{"$ref":"#/$defs/readSection_file"}]},"schema2":{"anyOf":[{"pattern":"\\S","type":"string"},{"type":"number"},{"type":"boolean"}]},"schema9":{"description":"Case-insensitive name filter; absence includes all names.","type":["string","null"]}},"additionalProperties":false,"description":"Fill exactly one action block: file, instructions, list, read."},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__cfoai__inspect_table_blocks","description":"Input constraint: Provide parameters for exactly one of: (bounds) or (compare) or (dimension) or (items) or (list) or (read) or (variable).\n\nLists saved tables (a summary each, or the full layout of tables named in target), reads selected cells, or compares saved states. One read returns several scenarios side by side when comparison names them. Rows and columns are objects with reusable refs. Rows carry formulas by range, bare values in column order, writability, and hidden-child counts; cell exceptions carry value and cell_formula. Columns carry the variable or dimension, grain, and date range; ranges defines each range once. Rows and columns are selected by inspected ref, unambiguous name, or coordinate predicate; depth controls descendants. include_edit_rules adds owned defaults and accepted actions. items and bounds inspect a dimension with or without a table target. references names the properties returned formulas use. variable and dimension inspect named objects and their dependents, or list them all. Unreadable evidence stays explicit. Reads never change the model. Omitted format uses json; an explicit format overrides it for this call.","input_schema":{"type":"object","properties":{"_context":{"additionalProperties":false,"description":"Optional active scenario, page, and time zone.","properties":{"layerId":{"description":"Active scenario ID.","type":"string"},"pageId":{"description":"Active page ID.","type":"string"},"timeZone":{"description":"Time zone, such as America/New_York.","type":"string"},"utcOffset":{"description":"UTC offset, such as -04:00.","type":"string"}},"type":"object"},"bounds":{"additionalProperties":false,"properties":{"dimension":{"$ref":"#/$defs/dimension"},"scenario":{"$ref":"#/$defs/scenario"},"target":{"$ref":"#/$defs/target"}},"required":["dimension"],"type":"object"},"compare":{"additionalProperties":false,"properties":{"after":{"$ref":"#/$defs/after_2"},"as_of_point":{"$ref":"#/$defs/as_of_point"},"before_change_log_id":{"description":"The earlier saved change to compare against. The comparison names rows removed or added since it under row_membership.","minimum":1,"type":"integer"},"columns":{"$ref":"#/$defs/columns"},"depth":{"$ref":"#/$defs/depth"},"format":{"$ref":"#/$defs/format"},"formula_origins":{"$ref":"#/$defs/formula_origins"},"include_edit_rules":{"$ref":"#/$defs/include_edit_rules"},"include_inputs":{"$ref":"#/$defs/include_inputs"},"limit":{"$ref":"#/$defs/limit_2"},"periods":{"$ref":"#/$defs/periods"},"rows":{"$ref":"#/$defs/rows"},"scenario":{"$ref":"#/$defs/scenario"},"source_health":{"$ref":"#/$defs/source_health"},"target":{"minLength":1,"pattern":"\\S","type":"string"}},"required":["before_change_log_id","target"],"type":"object"},"dimension":{"additionalProperties":false,"properties":{"after":{"$ref":"#/$defs/after"},"as_of_point":{"$ref":"#/$defs/as_of_point"},"conditions":{"$ref":"#/$defs/conditions"},"limit":{"$ref":"#/$defs/limit"},"scenario":{"$ref":"#/$defs/scenario"},"target":{"$ref":"#/$defs/target_2"}},"type":"object"},"items":{"additionalProperties":false,"properties":{"after":{"$ref":"#/$defs/after_2"},"as_of_point":{"$ref":"#/$defs/as_of_point"},"dimension":{"$ref":"#/$defs/dimension"},"limit":{"$ref":"#/$defs/limit_2"},"scenario":{"$ref":"#/$defs/scenario"},"target":{"$ref":"#/$defs/target"}},"required":["dimension"],"type":"object"},"list":{"additionalProperties":false,"properties":{"after":{"$ref":"#/$defs/after_2"},"as_of_point":{"$ref":"#/$defs/as_of_point"},"limit":{"$ref":"#/$defs/limit_2"},"page":{"description":"Limit a table list to this existing page.","type":"string"},"scenario":{"$ref":"#/$defs/scenario"},"target":{"description":"Saved tables by name or ref, one or a list. Named tables come back in full: layout, signature, presentation, and property homes. Omission lists every table as a summary of row and column counts, first rows, and window; names that match nothing are reported under unresolved.","items":{"minLength":1,"pattern":"\\S","type":"string"},"maxItems":50,"minItems":1,"minLength":1,"pattern":"\\S","type":["string","array"]}},"type":"object"},"org_id":{"description":"Workspace ID or slug. Optional when you belong to one workspace. Otherwise, call list_orgs and choose an ID or slug. Numbers always identify workspace IDs.","type":["string","number"]},"read":{"additionalProperties":false,"properties":{"after":{"$ref":"#/$defs/after_2"},"as_of_point":{"$ref":"#/$defs/as_of_point"},"columns":{"$ref":"#/$defs/columns"},"comparison":{"anyOf":[{"enum":["saved","none"],"type":"string"},{"additionalProperties":false,"properties":{"measures":{"description":"Values per compared scenario: VALUE, DELTA (difference from the selected scenario), PERCENT (percent difference). Defaults to VALUE.","items":{"$ref":"#/$defs/schema4"},"maxItems":3,"minItems":1,"type":"array"},"scenarios":{"description":"Existing scenarios to read beside the selected scenario, by name or inspected reference.","items":{"minLength":1,"pattern":"\\S","type":"string"},"maxItems":50,"minItems":1,"type":"array"}},"required":["scenarios"],"type":"object"}],"description":"For action read. saved uses the saved comparison; none reads underlying values and formulas; an object compares the selected scenario with each named scenario in this one read, whatever the table saves. Defaults to saved. The saved table is unchanged."},"depth":{"$ref":"#/$defs/depth"},"format":{"$ref":"#/$defs/format"},"formula_origins":{"$ref":"#/$defs/formula_origins"},"grain":{"description":"Reads the table's Date periods rolled up to this coarser grain without changing the saved table; the grain the table already shows is its plain read. Each period holds what the model calculates at that grain: a variable's time rollup (its base periods summed, closed, or averaged) or a timeless formula recomputed there; a variable with neither reads blank. Rolled-up period columns are read-only; the saved table's own columns take writes.","enum":["QUARTER","YEAR"],"type":"string"},"include_edit_rules":{"$ref":"#/$defs/include_edit_rules"},"include_inputs":{"$ref":"#/$defs/include_inputs"},"limit":{"$ref":"#/$defs/limit_2"},"periods":{"$ref":"#/$defs/periods"},"recalculate":{"description":"Calculates the table from scratch, ignoring every cached or reused result, and makes that calculation the cached one so the page shows it too. Use it when a value disagrees with what the person sees, with another read, or with arithmetic you can check; the result's recalculated says whether the cached result differed. Needs comparison none: a saved or requested comparison refuses it. Costs a full calculation; not for routine reads.","type":"boolean"},"rows":{"$ref":"#/$defs/rows"},"scenario":{"$ref":"#/$defs/scenario"},"source_health":{"$ref":"#/$defs/source_health"},"target":{"minLength":1,"pattern":"\\S","type":"string"}},"required":["target"],"type":"object"},"scenario":{"description":"Scenario to use. Defaults to the scenario in view, which can change between turns.","type":["string","null"]},"variable":{"additionalProperties":false,"properties":{"after":{"$ref":"#/$defs/after"},"as_of_point":{"$ref":"#/$defs/as_of_point"},"conditions":{"$ref":"#/$defs/conditions"},"limit":{"$ref":"#/$defs/limit"},"scenario":{"$ref":"#/$defs/scenario"},"target":{"$ref":"#/$defs/target_2"}},"type":"object"}},"required":[],"$defs":{"after":{"description":"The previous page's next.after; it continues the same target, or the listing at the object and definition where that page stopped, at the same snapshot.","type":"string"},"after_2":{"description":"Grid continuations bind table, selection, scenario and snapshot. Focused next binds its definition page and snapshot. For items, copy the prior member spelling, including an empty string. For list, copy next.after.","type":"string"},"as_of_point":{"description":"Optional snapshot with exactly one point type. Absence selects the current state.","oneOf":[{"required":["change_log_id"]},{"required":["timestamp"]},{"required":["relative_duration"]},{"required":["calendar_boundary"]}],"properties":{"calendar_boundary":{"description":"A local calendar period boundary in the user's runtime timezone, for phrases such as \"yesterday\" or \"last month\"; UTC when no timezone is known.","properties":{"boundary":{"enum":["start","end"],"type":"string"},"offset":{"description":"0 is the current period, -1 the previous, 1 the next.","type":"integer"},"unit":{"description":"Weeks start on Monday.","enum":["day","week","month","quarter","year"],"type":"string"}},"required":["unit","offset","boundary"],"type":"object"},"change_log_id":{"description":"Exact or approximate changelog point. The backend resolves to this workspace's latest changelog at or before this ID.","minimum":0,"type":"integer"},"relative_duration":{"description":"A duration from now, such as \"a couple hours ago\" or \"a day from now\"; a day is 24 hours and a week is seven days.","properties":{"amount":{"minimum":1,"type":"integer"},"direction":{"enum":["ago","from_now"],"type":"string"},"unit":{"enum":["minute","hour","day","week"],"type":"string"}},"required":["amount","unit","direction"],"type":"object"},"timestamp":{"description":"Exact instant supplied by the user, runtime context, or a tool result, as RFC3339 or RFC3339Nano with a timezone.","type":"string"}},"type":"object"},"columns":{"description":"Column references as a read prints them, unambiguous names, a member by its path from its variable or its axis dimension, one bracket per breakdown level, or native coordinate predicates; a name in backticks selects the same column as the name without them. Omission includes the saved columns; explicit columns take precedence over periods.","items":{"anyOf":[{"pattern":"\\S","type":"string"},{"additionalProperties":false,"properties":{"period_range":{"additionalProperties":false,"description":"Inclusive system Date interval at the saved axis grain, with bounds in that grain's period spelling, such as 2026-07 through 2026-09 for month.","properties":{"end":{"pattern":"\\S","type":"string"},"grain":{"$ref":"#/$defs/schema1"},"start":{"pattern":"\\S","type":"string"}},"required":["grain","start","end"],"type":"object"}},"required":["period_range"],"type":"object"}]},"minItems":1,"type":"array"},"conditions":{"description":"Filter stored formula definitions by readable conditions. Omission includes every saved definition.","items":{"type":"string"},"type":"array"},"depth":{"anyOf":[{"minimum":0,"type":"integer"},{"enum":["all"],"type":"string"}],"description":"Descendant levels relative to selected rows, or saved roots when rows are omitted. With rows, omission returns those rows only; without rows, omission leaves the full saved tree eligible."},"dimension":{"description":"Existing workspace dimension by name or inspected reference, including imported dimensions before table placement.","minLength":1,"pattern":"\\S","type":"string"},"format":{"default":"json","description":"Optional compact JSON or addressed REAM encoding override. Omission uses the workspace's current default encoding.","enum":["json","ream"],"type":"string"},"formula_origins":{"description":"Each row or column already carries its formula per range under formulas, a cell that breaks that rule says so in the cell, and a row or column computed by a rule saved outside this table's nodes names that rule's owner and condition in inherited_from. Omission is off; a selection of exactly one cell defaults to all. zeros adds rules to rows containing a zero, blank, or error: every rule the engine ranked for the row, best first, with the ones that computed a cell marked selected. all adds rules to every row.","enum":["zeros","all","off"],"type":"string"},"include_edit_rules":{"description":"Adds each returned row's and column's editing rules: the actions the edit input accepts there, its owned Actuals and Forecast defaults with ownership and writability, and its formula roles. Omission returns writability alone; a refused write reports the rules it broke.","type":"boolean"},"include_inputs":{"description":"Expands one level of formula inputs beneath the selected rows. With one cell selected by rows and columns and comparison none, also explains its input values and sources. Input rows and evidence share the response budget.","type":"boolean"},"limit":{"description":"Saved formula definitions per page, default 100. A scope can span pages; next continues it. An oversized formula returns unavailable coverage instead of truncated text.","maximum":100,"minimum":1,"type":"integer"},"limit_2":{"description":"Maximum grid rows, items, or listed tables (500), or saved formula definitions (100). Defaults: grid 500, items 50, tables 100, formula definitions 100. Grid parents and descendants count separately. The response budget may stop earlier; calculation inputs stay complete.","maximum":500,"minimum":1,"type":"integer"},"periods":{"description":"boundaries returns only the first and last period of each range (where Actuals end and Forecast begins) and of the window, without changing the saved table. An explicit column selection takes precedence.","enum":["boundaries"],"type":"string"},"rows":{"description":"Row references as a read prints them, unambiguous names or full paths, a member by its path from its variable or its axis dimension, one bracket per breakdown level (Revenue[West], Revenue[West][Enterprise], Employee ID[E-207], and Revenue[empty:None] for the member with no value), or native coordinate predicates; a name in backticks selects the same row as the name without them. Matches are deduplicated in saved order. Omission leaves the saved tree eligible. A read that names rows or columns holds every member of the layout, zero and empty members included, whatever the saved display hides; a read that names none shows what the app displays.","items":{"anyOf":[{"pattern":"\\S","type":"string"},{"additionalProperties":false,"properties":{"period_range":{"additionalProperties":false,"description":"Inclusive system Date interval at the saved axis grain, with bounds in that grain's period spelling, such as 2026-07 through 2026-09 for month.","properties":{"end":{"pattern":"\\S","type":"string"},"grain":{"$ref":"#/$defs/schema1"},"start":{"pattern":"\\S","type":"string"}},"required":["grain","start","end"],"type":"object"}},"required":["period_range"],"type":"object"}]},"minItems":1,"type":"array"},"scenario":{"description":"Scenario to use. Defaults to the scenario in view, which can change between turns.","type":["string","null"]},"schema1":{"enum":["day","week","month","quarter","year"],"type":"string"},"schema4":{"enum":["VALUE","DELTA","PERCENT"],"type":"string"},"source_health":{"description":"Source status detail. Compact is the default.","enum":["compact","detailed","off"],"type":"string"},"target":{"description":"Optional saved table that must contain the dimension. Without it, the read covers imported or manual members before any table exists.","minLength":1,"pattern":"\\S","type":"string"},"target_2":{"description":"A workspace-wide variable or dimension reference, or a list of them, including at a historical snapshot. A list answers with one entry per reference in the order given, each source query stated once under sources, and a reference that matches nothing refused in its own entry. Omission lists every readable variable or dimension in the scenario as the same entries, in saved order, with next continuing the listing.","items":{"minLength":1,"pattern":"\\S","type":"string"},"maxItems":50,"minItems":1,"minLength":1,"pattern":"\\S","type":["string","array"]}},"additionalProperties":false,"description":"Fill exactly one action block: bounds, compare, dimension, items, list, read, variable. Fields beside the block apply to it: scenario."},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__cfoai__list_orgs","description":"List your workspaces, including each ID, name, slug, and your role. Use an ID or slug as org_id for another tool. Tools select your workspace automatically when you belong to only one.","input_schema":{"type":"object","properties":{},"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__crustdata__execute","description":"Run a plain-JavaScript script that drives Crustdata — the only I/O is `const r = await callTool(name, params)`. The `code` field carries the contract; read crustdata://catalog for the rules and a section index.","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"code":{"type":"string","minLength":1,"description":"The script. It MUST begin with a source-labeled query comment — `// user query: <the user's request in their own words>` (e.g. `// user query: find engineering leaders at Stripe and get their work emails`) when this run serves the user's literal ask, and/or `// model query: <what THIS run does>` when it's your own derived query rather than the user's words. At least one is required (a run/session issues many execute calls — label the call carrying the user's ask `user`, your follow-up calls `model`); recorded for operators, never shown to the user. A script with no labeled comment is rejected before running (verification_failed, zero spend) and must be resubmitted with the line prepended. Use `return` to send back a value.\n\nWrite a plain-JavaScript body. Author it against the TypeScript-typed tool surface from get_schema, but write NO type annotations — a `: Type`/`as`/generic fails the whole run at parse, zero spend. The ONLY I/O is `const r = await callTool(name, params)` → `{ok:true,data}|{ok:false,status,errorType,message}`; always branch on `r.ok` (or `unwrap(await callTool(...))` to throw instead of silently proceeding on empty data). A toolkit is preloaded in the sandbox — no import, and (except `paginate` and `parallelMap`) do NOT await it: query builder (eq, and_, or_, gte, in_, any_of, field, chunk), result shapers (project, pick, compact, paginate, parallelMap, firstArray, unwrap), response accessors (profileUrl, currentCompanyIds, businessEmails), introspection (keys, shape), and watchPreviewTable(preview, body) to render a watch preview for the user. await only callTool, sleep, paginate, and parallelMap. Progress survives a bad run: when the run times out OR fails (a thrown error, a crashed pipeline, a client cancelling), the result carries a `partial`. The host fills it automatically with the results of every tool call that completed — you are billed for those either way, so they come back for you to resume from. `checkpoint(accumulator)` (synchronous) additionally saves YOUR value — call it after each costly stage when your own accumulator is what you want back, and it takes precedence over the automatic capture. If the captured rows overflow the size cap, `partial.resume` still carries each paginated call's `next_cursor` (and any `batch_id`), so you continue from where the run stopped instead of re-walking it — no paid re-run to recover it. Recovery is NOT automatic: pass the failed run's `partial` back to the next execute as `inputs` (the script reads it as `inputs.partial`) and write that script to skip the stages it already completed. Run INDEPENDENT calls (bulk enrich/lookup, per-entity sub-queries) concurrently with parallelMap instead of an await-loop. Return the smallest projection you need. Before a long or expensive script, `dry_run: true` rehearses it against fixtures for zero credits and reports where it breaks — a lint, not a check that the answer is right. Its values come from committed fixtures rather than from the API, so they are sample data with no bearing on the real answer (crustdata://catalog/dry-run)."},"inputs":{"description":"Data made available to the script as the `inputs` global (e.g. `inputs.ids`), not interpolated into code. Carry IDs/cursors from a prior run forward instead of re-fetching.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"maxOutputBytes":{"description":"Cap this run's returned value to ~this many bytes; over it the result comes back as a head + a `truncated` note. Only tightens the server default, never loosens it.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"checkpoint_every_ms":{"description":"How often this run saves recoverable progress, in ms. Set it BELOW your client's cancellation timeout — the calls a cancelled run already dispatched are billed either way, and a committed checkpoint is what lets you resume instead of re-paying. Cursor cancels at a hard 60s; other clients run longer. Only tightens the server default, never loosens it, and cannot be disabled from here: progress you were charged for is not yours to throw away. Rarely needed — the default already sits under the tightest known client ceiling.","type":"integer","exclusiveMinimum":0,"maximum":600000},"dry_run":{"description":"Rehearse instead of running: every callTool is answered from a committed response fixture, so the whole script executes for ZERO credits and zero network. Returns where it broke, the tool calls it would make, and the SHAPE of what it would return, rather than data: the values are committed fixtures rather than API responses, so they are sample data and carry no information about the real answer. It is a lint, not a rehearsal of the answer: it cannot tell you a result is wrong, and cannot see anything that depends on real values (a 403 on your plan, a 429, an empty result set). Worth it before a long or expensive script; skip it for a one-call lookup, where just running it costs the same.","type":"boolean"},"budget":{"description":"Optional context budget + client capabilities, injected by a client hook. `maxOutputBytes`/`maxOutputTokens` size the return when `maxOutputBytes` (top-level) is absent (tighten only); `clientCapabilities.fileWrite` tells the overflow `truncated` note whether this client can persist pages to disk.","type":"object","properties":{"maxOutputBytes":{"description":"Cap this run's returned value to ~this many bytes when top-level `maxOutputBytes` is absent; over it the result comes back as a head + a `truncated` note. Only tightens the server default, never loosens it.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"maxOutputTokens":{"description":"Alternate size cap in tokens; used as `maxOutputTokens * 4` bytes when neither top-level nor budget `maxOutputBytes` is set. Only tightens the server default.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"freeTokens":{"description":"Remaining tokens in the client's context window, injected by a client hook. Informational; the server sizes the return from `maxOutputBytes`/`maxOutputTokens`, not this field.","type":"number"},"clientCapabilities":{"description":"Capabilities of the calling client, injected by a client hook. `fileWrite` tells the overflow `truncated` note whether this client can persist pages to disk.","type":"object","properties":{"fileWrite":{"description":"If true, the overflow `truncated` note tells the model this client can persist pages to disk.","type":"boolean"}},"additionalProperties":{}}},"additionalProperties":{}}},"required":["code"]},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__crustdata__get_schema","description":"Return the input fields, filterable columns, and response shape for the named tools.","input_schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"names":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string"},"description":"Tool names to describe (max 50; duplicates are ignored)."},"detail":{"description":"How much schema to return. `summary` (default) is the common filter columns plus a pointer to the rest; `detailed` is the full filterable-column list plus an example response.","type":"string","enum":["summary","detailed"]},"group":{"description":"Expand ONE projectable group (or dotted prefix) to its exact `fields` sub-paths, for narrow projection. When set, the response is just that group's leaf paths per tool — call this only for a group you intend to project narrowly.","type":"string"}},"required":["names"]},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__crustdata__list_tools","description":"List the underlying Crustdata tools callable from inside execute() via callTool(name, params).","input_schema":{"type":"object","properties":{}},"eager_input_streaming":true,"defer_loading":true}],"toolInputCopies":[{"id":"toolu_01JCJBY77eM4gEbn8gUiokk5","copy":"wire"}]},"type":"attachment","uuid":"31bf151f-f56f-4c2c-a449-1ecca20b9b0c","timestamp":"2026-10-12T06:46:19.403Z","userType":"external","entrypoint":"claude-vscode","cwd":"D:\\storybound","sessionId":"531bd6f2-4e0c-4a05-a2e1-9f902bd0eeb6","version":"2.1.296","gitBranch":"experiments/architecture-and-chaos","slug":"glimmering-splashing-ladybug"}
