,"gitBranch":"experiments/architecture-and-chaos","slug":"glimmering-splashing-ladybug"}
{"parentUuid":"178cdfe1-7304-42af-8b7f-cad4b9eb18d5","isSidechain":false,"promptId":"419f33fc-96f6-4c2c-b1fc-7ed7e9517d67","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LF9N6YQZsjJEFJHga5bR1m","type":"tool_result","content":"// One small pure reducer: folds the backend's event stream (docs/API.md \"Events\") into UI state.\r\n// No I/O, no timers. Replayed events (reconnect with Last-Event-ID, or a late join) are ignored by `id`.\r\nimport type { CharacterCard, Commitment, Degradation, Page, Quiz, Receipt, SafetyAction, StoryEvent, VerdictStatus } from '../api/types';\r\n\r\nexport type Step =\r\n  | 'start' | 'looking' | 'meeting' | 'promise' | 'planning' | 'writing' | 'checking' | 'fixing' | 'painting' | 'voice' | 'wrapping' | 'done';\r\n\r\nexport type PromiseKind = 'waiting' | 'checking' | 'fixing' | 'kept' | 'kept_after_fix' | 'not_kept' | 'unchecked';\r\n\r\nexport interface PromiseState extends Commitment {\r\n  state: PromiseKind;\r\n  done: number; // how many of `expected` places have a passing latest verdict\r\n  expected: number;\r\n  everBad: boolean; // a check failed at some point (so \"kept\" means \"kept after a fix\")\r\n}\r\n\r\nexport interface MediaState { image?: string; audio?: string; seconds?: number; imageMissing?: boolean; audioMissing?: boolean }\r\nexport interface RepairNote { index: number; attempt: number; failed: string[]; because: string }\r\n\r\nexport type Net = 'ok' | 'reconnecting' | 'lost';\r\n\r\nexport interface StoryState {\r\n  phase: 'idle' | 'running' | 'finished' | 'refused' | 'error';\r\n  net: Net;\r\n  lastId: number; // highest event id folded so far (-1 = none)\r\n  storyId?: string; lessonId?: string; arm?: string;\r\n  safety?: { tier: string; action: SafetyAction; ignoredText: string[]; reasonCode: string };\r\n  card?: CharacterCard;\r\n  oathHash?: string;\r\n  promises: PromiseState[];\r\n  beats: string[];\r\n  totalPages: number;\r\n  step: { kind: Step; index?: number };\r\n  pages: Page[]; // accepted pages, in order\r\n  attempts: Record<number, number>; // page index -> attempts used (0 = first try)\r\n  media: Record<number, MediaState>;\r\n  repairs: RepairNote[];\r\n  degradations: Degradation[];\r\n  verdicts: Record<string, Record<string, { status: VerdictStatus; attempt: number }>>; // commitment -> scope -> latest\r\n  everBad: Record<string, boolean>; // commitment -> a check failed at some point (run-level checks come before the oath)\r\n  receipt?: Receipt;\r\n  quiz?: Quiz; // only questions that passed every quiz promise\r\n  outcome?: 'shipped' | 'shipped_with_notes';\r\n  refusal?: { reasonCode: string; message: string; traceId: string };\r\n  error?: { code: string; message: string };\r\n  eventCount: number;\r\n}\r\n\r\nexport const DEFAULT_PAGES = 8;\r\n\r\nexport const initialStory: StoryState = {\r\n  phase: 'idle', net: 'ok', lastId: -1, promises: [], beats: [], totalPages: DEFAULT_PAGES, step: { kind: 'start' },\r\n  pages: [], attempts: {}, media: {}, repairs: [], degradations: [], verdicts: {}, everBad: {}, eventCount: 0,\r\n};\r\n\r\nexport type StoryAction = { type: 'reset' } | { type: 'event'; ev: StoryEvent } | { type: 'net'; net: Net };\r\n\r\nconst BAD: VerdictStatus[] = ['violation', 'critical'];\r\nconst OK: VerdictStatus[] = ['pass', 'warning', 'skipped'];\r\n\r\nfunction expectedPlaces(scope: Commitment['scope'], totalPages: number): number {\r\n  return scope === 'run' || scope === 'story' ? 1 : totalPages;\r\n}\r\n\r\n/** Work out one promise's state from the latest verdict per place. Pure; used after every verdict. */\r\nfunction refreshPromise(p: PromiseState, places: Record<string, { status: VerdictStatus }> | undefined, totalPages: number): PromiseState {\r\n  if (p.state === 'not_kept' || p.state === 'unchecked') return p;\r\n  const entries = Object.values(places ?? {});\r\n  const expected = expectedPlaces(p.scope, totalPages);\r\n  const done = entries.filter((e) => OK.includes(e.status)).length;\r\n  const anyPass = entries.some((e) => e.status === 'pass' || e.status === 'warning');\r\n  let state: PromiseKind = 'waiting';\r\n  if (entries.some((e) => BAD.includes(e.status))) state = 'fixing';\r\n  else if (done >= expected && anyPass) state = p.everBad ? 'kept_after_fix' : 'kept';\r\n  else if (entries.length) state = 'checking';\r\n  return { ...p, state, done, expected };\r\n}\r\n\r\nfunction finalise(state: StoryState, receipt: Receipt): PromiseState[] {\r\n  const broken = new Set(receipt.broken ?? []);\r\n  return state.promises.map((p) => {\r\n    const places = Object.values(state.verdicts[p.id] ?? {});\r\n    if (broken.has(p.id)) return { ...p, state: 'not_kept' as const };\r\n    if (!places.some((e) => e.status !== 'skipped')) return { ...p, state: 'unchecked' as const };\r\n    return { ...p, state: p.everBad ? ('kept_after_fix' as const) : ('kept' as const) };\r\n  });\r\n}\r\n\r\n/** Where is the run now? Recomputed whenever media events change what is outstanding. */\r\nfunction mediaStep(s: StoryState): Step {\r\n  const n = s.totalPages;\r\n  const imagesLeft = Array.from({ length: n }, (_, i) => i + 1).some((i) => !s.media[i]?.image && !s.media[i]?.imageMissing);\r\n  if (imagesLeft) return 'painting';\r\n  const audioLeft = Array.from({ length: n }, (_, i) => i + 1).some((i) => !s.media[i]?.audio && !s.media[i]?.audioMissing);\r\n  return audioLeft ? 'voice' : 'wrapping';\r\n}\r\n\r\nexport function storyReducer(state: StoryState, action: StoryAction): StoryState {\r\n  if (action.type === 'reset') return initialStory;\r\n  if (action.type === 'net') return state.net === action.net ? state : { ...state, net: action.net };\r\n  const ev = action.ev;\r\n  if (ev.id !== undefined) {\r\n    if (ev.id <= state.lastId) return state; // replay after a reconnect\r\n  }\r\n  const base: StoryState = { ...state, net: 'ok', lastId: ev.id ?? state.lastId, eventCount: state.eventCount + 1, phase: state.phase === 'idle' ? 'running' : state.phase };\r\n\r\n  switch (ev.type) {\r\n    case 'run.started':\r\n      return { ...base, phase: 'running', storyId: ev.data.story_id, lessonId: ev.data.lesson_id, arm: ev.data.arm, step: { kind: 'looking' } };\r\n\r\n    case 'safety.result':\r\n      return {\r\n        ...base,\r\n        safety: { tier: ev.data.tier, action: ev.data.action, ignoredText: ev.data.ignored_text ?? [], reasonCode: ev.data.reason_code },\r\n        step: { kind: ev.data.action === 'refuse' || ev.data.action === 'ask_redraw' ? 'looking' : 'meeting' },\r\n      };\r\n\r\n    case 'character.ready':\r\n      return { ...base, card: ev.data.card, step: { kind: 'promise' } };\r\n\r\n    case 'oath.ready': {\r\n      const promises = ev.data.commitments.map((c) => {\r\n        const places = state.verdicts[c.id];\r\n        return refreshPromise({ ...c, state: 'waiting', done: 0, expected: expectedPlaces(c.scope, state.totalPages), everBad: !!state.everBad[c.id] }, places, state.totalPages);\r\n      });\r\n      return { ...base, oathHash: ev.data.oath_hash, promises, step: { kind: 'planning' } };\r\n    }\r\n\r\n    case 'plan.ready': {\r\n      const totalPages = ev.data.beats.length || DEFAULT_PAGES;\r\n      return { ...base, beats: ev.data.beats, totalPages, step: { kind: 'writing', index: 1 } };\r\n    }\r\n\r\n    case 'scene.started':\r\n      return { ...base, step: ev.data.attempt > 0 ? { kind: 'checking', index: ev.data.index } : { kind: 'writing', index: ev.data.index } };\r\n\r\n    case 'verdict': {\r\n      const v = ev.data;\r\n      const places = { ...(state.verdicts[v.commitment] ?? {}), [v.scope]: { status: v.status, attempt: v.attempt } };\r\n      const verdicts = { ...state.verdicts, [v.commitment]: places };\r\n      const bad = BAD.includes(v.status);\r\n      const everBad = bad ? { ...state.everBad, [v.commitment]: true } : state.everBad;\r\n      const promises = state.promises.map((p) => (p.id === v.commitment ? refreshPromise({ ...p, everBad: p.everBad || bad }, places, state.totalPages) : p));\r\n      const m = /^scene (\\d+)$/.exec(v.scope);\r\n      const step = m && state.step.kind !== 'fixing' ? { kind: 'checking' as const, index: Number(m[1]) } : state.step;\r\n      return { ...base, verdicts, everBad, promises, step };\r\n    }\r\n\r\n    case 'scene.repair':\r\n      return {\r\n        ...base,\r\n        repairs: [...state.repairs, { index: ev.data.index, attempt: ev.data.attempt, failed: ev.data.failed, because: ev.data.because }],\r\n        step: { kind: 'fixing', index: ev.data.index },\r\n      };\r\n\r\n    case 'scene.accepted': {\r\n      const page = ev.data.page;\r\n      const pages = [...state.pages.filter((p) => p.index !== page.index), page].sort((a, b) => a.index - b.index);\r\n      const attempts = { ...state.attempts, [page.index]: ev.data.attempts_used };\r\n      const all = pages.length >= state.totalPages;\r\n      return { ...base, pages, attempts, step: all ? { kind: 'painting' } : { kind: 'writing', index: page.index + 1 } };\r\n    }\r\n\r\n    case 'image.ready': {\r\n      const media = { ...state.media, [ev.data.index]: { ...state.media[ev.data.index], image: ev.data.url, imageMissing: false } };\r\n      const next = { ...base, media };\r\n      return { ...next, step: state.pages.length >= state.totalPages ? { kind: mediaStep(next) } : state.step };\r\n    }\r\n\r\n    case 'audio.ready': {\r\n      const media = { ...state.media, [ev.data.index]: { ...state.media[ev.data.index], audio: ev.data.url, seconds: ev.data.seconds, audioMissing: false } };\r\n      const next = { ...base, media };\r\n      return { ...next, step: state.pages.length >= state.totalPages ? { kind: mediaStep(next) } : state.step };\r\n    }\r\n\r\n    case 'quiz.ready':\r\n      return { ...base, quiz: ev.data };\r\n\r\n    case 'degraded': {\r\n      const d = ev.data;\r\n      let media = state.media;\r\n      if (d.index && d.what === 'image') media = { ...media, [d.index]: { ...media[d.index], imageMissing: true } };\r\n      if (d.index && d.what === 'audio') media = { ...media, [d.index]: { ...media[d.index], audioMissing: true } };\r\n      const next = { ...base, media, degradations: [...state.degradations, d] };\r\n      return d.index && state.pages.length >= state.totalPages ? { ...next, step: { kind: mediaStep(next) } } : next;\r\n    }\r\n\r\n    case 'receipt':\r\n      return { ...base, receipt: ev.data, promises: finalise(state, ev.data), step: { kind: 'wrapping' } };\r\n\r\n    case 'run.finished':\r\n      return { ...base, phase: 'finished', outcome: ev.data.outcome, step: { kind: 'done' } };\r\n\r\n    case 'run.refused':\r\n      return { ...base, phase: 'refused', refusal: { reasonCode: ev.data.reason_code, message: ev.data.message, traceId: ev.data.trace_id } };\r\n\r\n    case 'error':\r\n      return { ...base, phase: 'error', error: ev.data };\r\n\r\n    default:\r\n      return base; // unknown event types are ignored: additions to the contract must never break the page\r\n  }\r\n}\r\n\r\n// ---- selectors (pure helpers the screens use) ----------------------------------------------------------------------------------\r\n\r\nexport type MediaKind = 'ready' | 'pending' | 'missing';\r\n\r\nexport function imageStatus(s: StoryState, index: number): MediaKind {\r\n  const m = s.media[index];\r\n  if (m?.image) return 'ready';\r\n  if (m?.imageMissing) return 'missing';\r\n  return s.phase === 'running' ? 'pending' : 'missing';\r\n}\r\n\r\nexport function audioStatus(s: StoryState, index: number): MediaKind {\r\n  const m = s.media[index];\r\n  if (m?.audio) return 'ready';\r\n  if (m?.audioMissing) return 'missing';\r\n  return s.phase === 'running' ? 'pending' : 'missing';\r\n}\r\n\r\nexport function isDone(s: StoryState): boolean {\r\n  return s.phase === 'finished' || s.phase === 'refused' || s.phase === 'error';\r\n}\r\n\r\n/** Pages are all here and the run is over: the child can reach the end screen. */\r\nexport function allPagesIn(s: StoryState): boolean {\r\n  return s.pages.length >= s.totalPages;\r\n}\r\n\r\nexport const REDRAW_CODES = ['too_small', 'blank', 'no_character'];\r\nexport function isRedraw(reasonCode: string | undefined): boolean {\r\n  return !!reasonCode && REDRAW_CODES.includes(reasonCode);\r\n}\r\n\r\n/** Final status of the oath for the parent: only meaningful once the receipt arrived. */\r\nexport function keptCounts(s: StoryState) {\r\n  const c = { kept: 0, keptAfterFix: 0, notKept: 0, unchecked: 0, open: 0 };\r\n  for (const p of s.promises) {\r\n    if (p.state === 'kept') c.kept++;\r\n    else if (p.state === 'kept_after_fix') c.keptAfterFix++;\r\n    else if (p.state === 'not_kept') c.notKept++;\r\n    else if (p.state === 'unchecked') c.unchecked++;\r\n    else c.open++;\r\n  }\r\n  return c;\r\n}\r\nimport { useEffect, useRef, useState } from 'react';\nimport type { Choice, Page } from '../api/types';\nimport { Btn } from '../components/Btn';\nimport { ConfirmPictures } from '../components/ConfirmPictures';\nimport { Icon } from '../components/Icon';\nimport { Pip } from '../components/Pip';\nimport { SoundToggle } from '../components/SoundToggle';\nimport { Stones } from '../components/Stones';\nimport { nowPlaying, play, say, sfx, stop, subscribePlaying } from '../lib/sound';\nimport { stepLine } from '../lib/steps';\nimport { useSettings } from '../state/settings';\nimport { useFocusHeading, type Source } from '../state/session';\nimport { audioStatus, imageStatus, isDone, type StoryState } from '../state/storyReducer';\n\n// 6.7 The story reader. Works with whatever has arrived: a page can be read before its picture or voice exists, and a page\n// whose picture or voice never comes is a calm text-only page (never an error).\n\nfunction usePlaying(url: string | undefined): boolean {\n  const [now, setNow] = useState<string | null>(nowPlaying());\n  useEffect(() => subscribePlaying(setNow), []);\n  return !!url && now === url;\n}\n\nfunction Picture({ story, page, source }: { story: StoryState; page: Page; source: Source | null }) {\n  const status = imageStatus(story, page.index);\n  const url = story.media[page.index]?.image;\n  const [broken, setBroken] = useState(false);\n  useEffect(() => setBroken(false), [url]);\n  return (\n    <figure className=\"picture\" data-status={broken ? 'missing' : status}>\n      {status === 'ready' && !broken ? (\n        <img src={url} alt={page.scenario} onError={() => setBroken(true)} />\n      ) : status === 'pending' && !broken ? (\n        <div className=\"paper-cut\" role=\"status\">\n          <Pip pose=\"bubble\" className=\"cut-pip\" />\n          <p>Pip is still painting this picture…</p>\n        </div>\n      ) : (\n        <div className=\"paper-cut\">\n          <Pip pose=\"read\" className=\"cut-pip\" />\n          <p>{story.degradations.some((d) => d.what === 'image' && d.index === page.index && /kept its picture budget|paints some pages only/.test(d.why))\n            ? 'Pip saved the paint for the big moments. Listen to this page!'\n            : 'No picture on this page. The words still tell the story!'}</p>\n        </div>\n      )}\n      {source && <img className=\"hero-sticker\" src={source.url} alt=\"\" />}\n    </figure>\n  );\n}\n\nfunction Listen({ story, page }: { story: StoryState; page: Page }) {\n  const status = audioStatus(story, page.index);\n  const url = story.media[page.index]?.audio;\n  const playing = usePlaying(url);\n  if (status === 'missing') {\n    return <p className=\"no-sound\"><Icon name=\"speaker-slash\" /> No voice on this page</p>;\n  }\n  if (status === 'pending') {\n    return <p className=\"no-sound\"><Icon name=\"speaker-high\" /> Pip is finding a voice…</p>;\n  }\n  return (\n    <Btn variant=\"sky\" icon={playing ? 'speaker-slash' : 'speaker-high'} aria-pressed={playing} quiet\n      onClick={() => (playing ? stop() : play(url!))} className=\"listen\">\n      {playing ? 'Stop' : 'Listen'}\n    </Btn>\n  );\n}\n\nfunction Waiting({ story, n }: { story: StoryState; n: number }) {\n  return (\n    <section className=\"waiting\" aria-live=\"polite\">\n      <Pip pose=\"daydream\" className=\"waiting-pip\" />\n      <h2>Page {n} is on its way!</h2>\n      <p>{stepLine(story)}</p>\n    </section>\n  );\n}\n\nexport function Reader({ story, source, startAt, onEnd, onLeave }: { story: StoryState; source: Source | null; startAt: number; onEnd(): void; onLeave(): void }) {\n  const h = useFocusHeading<HTMLHeadingElement>();\n  const { sound } = useSettings();\n  const [n, setN] = useState(startAt);\n  const [picked, setPicked] = useState<string | null>(null);\n  const [leaving, setLeaving] = useState(false);\n  const top = useRef<HTMLElement>(null);\n  const page = story.pages.find((p) => p.index === n);\n  const total = story.totalPages;\n  const mediaRef = useRef(story.media);\n  mediaRef.current = story.media;\n\n  const go = (to: number) => {\n    stop();\n    if (to > total) { onEnd(); return; }\n    if (to < 1) return;\n    sfx('page-turn');\n    setN(to);\n    setPicked(null);\n  };\n\n  // New page: scroll to the top, and read it aloud if sound is on and the voice is already here (a tap is never needed again:\n  // the first tap on Welcome unlocked audio). A voice that arrives later is only played when the child taps Listen.\n  useEffect(() => {\n    top.current?.scrollIntoView?.({ block: 'start' });\n    const audio = mediaRef.current[n]?.audio;\n    if (sound && audio) play(audio);\n    return () => stop();\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [n]);\n\n  // If the story ended without this page (it never arrived), go to the end rather than wait forever.\n  useEffect(() => { if (!page && isDone(story)) onEnd(); }, [page, story, onEnd]);\n\n  useEffect(() => {\n    const key = (e: KeyboardEvent) => {\n      if ((e.target as HTMLElement)?.closest?.('input, textarea')) return;\n      if (e.key === 'ArrowRight') go(n + 1);\n      if (e.key === 'ArrowLeft') go(n - 1);\n    };\n    window.addEventListener('keydown', key);\n    return () => window.removeEventListener('keydown', key);\n  });\n\n  const choose = (c: Choice) => {\n    setPicked(c.id);\n    stop();\n    if (c.is_correct) { sfx('star-pop'); sfx('happy-chime'); say('reader-kind'); } else { sfx('soft-boop'); say('reader-think'); }\n  };\n\n  const pickedChoice = page?.choices.find((c) => c.id === picked);\n  const hasNext = n < total;\n\n  return (\n    <main className=\"screen reader\" data-page={n}>\n      <header className=\"screen-head\">\n        <button type=\"button\" className=\"corner-btn\" onClick={() => setLeaving(true)} aria-label=\"Leave the story\"><Icon name=\"door\" /></button>\n        <Stones story={story} active={n} onPick={(i) => go(i)} />\n        <SoundToggle />\n      </header>\n\n      <h1 ref={h} tabIndex={-1} className=\"sr-only\">Page {n} of {total}</h1>\n      <article className=\"spread\" ref={top} key={n}>\n        {page ? (\n          <>\n            <section className=\"page page-left\" aria-label=\"Picture\">\n              <Picture story={story} page={page} source={source} />\n            </section>\n            <section className=\"page page-right\" aria-label=\"The story\">\n              <div className=\"plate\">\n                <p className=\"scenario\">{page.scenario}</p>\n                <Listen story={story} page={page} />\n              </div>\n              <h2 className=\"question\">{page.question}</h2>\n              <div className=\"choices\" role=\"group\" aria-label=\"Choices\">\n                {page.choices.map((c) => {\n                  const chosen = picked === c.id;\n                  const mood = chosen ? (c.is_correct ? 'kind' : 'think') : 'idle';\n                  return (\n                    <button key={c.id} type=\"button\" className=\"choice\" data-mood={mood} aria-pressed={chosen} onClick={() => choose(c)}>\n                      <span className=\"choice-badge\" aria-hidden=\"true\">\n                        {mood === 'kind' ? <Icon name=\"star\" /> : mood === 'think' ? <Icon name=\"lightbulb\" /> : <span>{c.id.toUpperCase()}</span>}\n                      </span>\n                      <span className=\"choice-text\">{c.text}</span>\n                    </button>\n                  );\n                })}\n              </div>\n              <div className=\"feedback-slot\" aria-live=\"polite\">\n                {pickedChoice && (\n                  <div className=\"feedback\" data-mood={pickedChoice.is_correct ? 'kind' : 'think'}>\n                    <Pip pose={pickedChoice.is_correct ? 'cool' : 'dizzy'} className=\"feedback-pip\" />\n                    <div>\n                      <p className=\"feedback-head\">{pickedChoice.is_correct ? 'That was a kind thing to do!' : 'Hmm, let’s think about that.'}</p>\n                      <p className=\"feedback-text\">{pickedChoice.feedback}</p>\n                    </div>\n                  </div>\n                )}\n              </div>\n              {pickedChoice && (\n                <div className=\"after-pick\">\n                  {!pickedChoice.is_correct && <p className=\"try-other\">Try the other one!</p>}\n                  <Btn big iconAfter={hasNext ? 'arrow-right' : 'star'} className=\"next-inline\" onClick={() => go(n + 1)}>{hasNext ? 'Next' : 'The end'}</Btn>\n                </div>\n              )}\n            </section>\n          </>\n        ) : (\n          <Waiting story={story} n={n} />\n        )}\n      </article>\n\n      {n > 1 && <button type=\"button\" className=\"side-arrow left\" aria-label=\"Previous page\" onClick={() => go(n - 1)}><Icon name=\"arrow-left\" /></button>}\n      {(page || hasNext) && <button type=\"button\" className=\"side-arrow right\" aria-label={hasNext ? 'Next page' : 'The end'} onClick={() => go(n + 1)}><Icon name={hasNext ? 'arrow-right' : 'star'} /></button>}\n\n      {leaving && <ConfirmPictures title=\"Leave the story?\" yesLabel=\"Yes, leave\" noLabel=\"Keep reading\" pose=\"wink\" onNo={() => setLeaving(false)} onYes={onLeave} />}\n    </main>\n  );\n}","is_error":false}]},"uuid":"4b865851-6022-4ae3-be27-9173ee5634fc","timestamp":"2026-10-12T08:53:39.168Z","toolUseResult":{"stdout":"// One small pure reducer: folds the backend's event stream (docs/API.md \"Events\") into UI state.\r\n// No I/O, no timers. Replayed events (reconnect with Last-Event-ID, or a late join) are ignored by `id`.\r\nimport type { CharacterCard, Commitment, Degradation, Page, Quiz, Receipt, SafetyAction, StoryEvent, VerdictStatus } from '../api/types';\r\n\r\nexport type Step =\r\n  | 'start' | 'looking' | 'meeting' | 'promise' | 'planning' | 'writing' | 'checking' | 'fixing' | 'painting' | 'voice' | 'wrapping' | 'done';\r\n\r\nexport type PromiseKind = 'waiting' | 'checking' | 'fixing' | 'kept' | 'kept_after_fix' | 'not_kept' | 'unchecked';\r\n\r\nexport interface PromiseState extends Commitment {\r\n  state: PromiseKind;\r\n  done: number; // how many of `expected` places have a passing latest verdict\r\n  expected: number;\r\n  everBad: boolean; // a check failed at some point (so \"kept\" means \"kept after a fix\")\r\n}\r\n\r\nexport interface MediaState { image?: string; audio?: string; seconds?: number; imageMissing?: boolean; audioMissing?: boolean }\r\nexport interface RepairNote { index: number; attempt: number; failed: string[]; because: string }\r\n\r\nexport type Net = 'ok' | 'reconnecting' | 'lost';\r\n\r\nexport interface StoryState {\r\n  phase: 'idle' | 'running' | 'finished' | 'refused' | 'error';\r\n  net: Net;\r\n  lastId: number; // highest event id folded so far (-1 = none)\r\n  storyId?: string; lessonId?: string; arm?: string;\r\n  safety?: { tier: string; action: SafetyAction; ignoredText: string[]; reasonCode: string };\r\n  card?: CharacterCard;\r\n  oathHash?: string;\r\n  promises: PromiseState[];\r\n  beats: string[];\r\n  totalPages: number;\r\n  step: { kind: Step; index?: number };\r\n  pages: Page[]; // accepted pages, in order\r\n  attempts: Record<number, number>; // page index -> attempts used (0 = first try)\r\n  media: Record<number, MediaState>;\r\n  repairs: RepairNote[];\r\n  degradations: Degradation[];\r\n  verdicts: Record<string, Record<string, { status: VerdictStatus; attempt: number }>>; // commitment -> scope -> latest\r\n  everBad: Record<string, boolean>; // commitment -> a check failed at some point (run-level checks come before the oath)\r\n  receipt?: Receipt;\r\n  quiz?: Quiz; // only questions that passed every quiz promise\r\n  outcome?: 'shipped' | 'shipped_with_notes';\r\n  refusal?: { reasonCode: string; message: string; traceId: string };\r\n  error?: { code: string; message: string };\r\n  eventCount: number;\r\n}\r\n\r\nexport const DEFAULT_PAGES = 8;\r\n\r\nexport const initialStory: StoryState = {\r\n  phase: 'idle', net: 'ok', lastId: -1, promises: [], beats: [], totalPages: DEFAULT_PAGES, step: { kind: 'start' },\r\n  pages: [], attempts: {}, media: {}, repairs: [], degradations: [], verdicts: {}, everBad: {}, eventCount: 0,\r\n};\r\n\r\nexport type StoryAction = { type: 'reset' } | { type: 'event'; ev: StoryEvent } | { type: 'net'; net: Net };\r\n\r\nconst BAD: VerdictStatus[] = ['violation', 'critical'];\r\nconst OK: VerdictStatus[] = ['pass', 'warning', 'skipped'];\r\n\r\nfunction expectedPlaces(scope: Commitment['scope'], totalPages: number): number {\r\n  return scope === 'run' || scope === 'story' ? 1 : totalPages;\r\n}\r\n\r\n/** Work out one promise's state from the latest verdict per place. Pure; used after every verdict. */\r\nfunction refreshPromise(p: PromiseState, places: Record<string, { status: VerdictStatus }> | undefined, totalPages: number): PromiseState {\r\n  if (p.state === 'not_kept' || p.state === 'unchecked') return p;\r\n  const entries = Object.values(places ?? {});\r\n  const expected = expectedPlaces(p.scope, totalPages);\r\n  const done = entries.filter((e) => OK.includes(e.status)).length;\r\n  const anyPass = entries.some((e) => e.status === 'pass' || e.status === 'warning');\r\n  let state: PromiseKind = 'waiting';\r\n  if (entries.some((e) => BAD.includes(e.status))) state = 'fixing';\r\n  else if (done >= expected && anyPass) state = p.everBad ? 'kept_after_fix' : 'kept';\r\n  else if (entries.length) state = 'checking';\r\n  return { ...p, state, done, expected };\r\n}\r\n\r\nfunction finalise(state: StoryState, receipt: Receipt): PromiseState[] {\r\n  const broken = new Set(receipt.broken ?? []);\r\n  return state.promises.map((p) => {\r\n    const places = Object.values(state.verdicts[p.id] ?? {});\r\n    if (broken.has(p.id)) return { ...p, state: 'not_kept' as const };\r\n    if (!places.some((e) => e.status !== 'skipped')) return { ...p, state: 'unchecked' as const };\r\n    return { ...p, state: p.everBad ? ('kept_after_fix' as const) : ('kept' as const) };\r\n  });\r\n}\r\n\r\n/** Where is the run now? Recomputed whenever media events change what is outstanding. */\r\nfunction mediaStep(s: StoryState): Step {\r\n  const n = s.totalPages;\r\n  const imagesLeft = Array.from({ length: n }, (_, i) => i + 1).some((i) => !s.media[i]?.image && !s.media[i]?.imageMissing);\r\n  if (imagesLeft) return 'painting';\r\n  const audioLeft = Array.from({ length: n }, (_, i) => i + 1).some((i) => !s.media[i]?.audio && !s.media[i]?.audioMissing);\r\n  return audioLeft ? 'voice' : 'wrapping';\r\n}\r\n\r\nexport function storyReducer(state: StoryState, action: StoryAction): StoryState {\r\n  if (action.type === 'reset') return initialStory;\r\n  if (action.type === 'net') return state.net === action.net ? state : { ...state, net: action.net };\r\n  const ev = action.ev;\r\n  if (ev.id !== undefined) {\r\n    if (ev.id <= state.lastId) return state; // replay after a reconnect\r\n  }\r\n  const base: StoryState = { ...state, net: 'ok', lastId: ev.id ?? state.lastId, eventCount: state.eventCount + 1, phase: state.phase === 'idle' ? 'running' : state.phase };\r\n\r\n  switch (ev.type) {\r\n    case 'run.started':\r\n      return { ...base, phase: 'running', storyId: ev.data.story_id, lessonId: ev.data.lesson_id, arm: ev.data.arm, step: { kind: 'looking' } };\r\n\r\n    case 'safety.result':\r\n      return {\r\n        ...base,\r\n        safety: { tier: ev.data.tier, action: ev.data.action, ignoredText: ev.data.ignored_text ?? [], reasonCode: ev.data.reason_code },\r\n        step: { kind: ev.data.action === 'refuse' || ev.data.action === 'ask_redraw' ? 'looking' : 'meeting' },\r\n      };\r\n\r\n    case 'character.ready':\r\n      return { ...base, card: ev.data.card, step: { kind: 'promise' } };\r\n\r\n    case 'oath.ready': {\r\n      const promises = ev.data.commitments.map((c) => {\r\n        const places = state.verdicts[c.id];\r\n        return refreshPromise({ ...c, state: 'waiting', done: 0, expected: expectedPlaces(c.scope, state.totalPages), everBad: !!state.everBad[c.id] }, places, state.totalPages);\r\n      });\r\n      return { ...base, oathHash: ev.data.oath_hash, promises, step: { kind: 'planning' } };\r\n    }\r\n\r\n    case 'plan.ready': {\r\n      const totalPages = ev.data.beats.length || DEFAULT_PAGES;\r\n      return { ...base, beats: ev.data.beats, totalPages, step: { kind: 'writing', index: 1 } };\r\n    }\r\n\r\n    case 'scene.started':\r\n      return { ...base, step: ev.data.attempt > 0 ? { kind: 'checking', index: ev.data.index } : { kind: 'writing', index: ev.data.index } };\r\n\r\n    case 'verdict': {\r\n      const v = ev.data;\r\n      const places = { ...(state.verdicts[v.commitment] ?? {}), [v.scope]: { status: v.status, attempt: v.attempt } };\r\n      const verdicts = { ...state.verdicts, [v.commitment]: places };\r\n      const bad = BAD.includes(v.status);\r\n      const everBad = bad ? { ...state.everBad, [v.commitment]: true } : state.everBad;\r\n      const promises = state.promises.map((p) => (p.id === v.commitment ? refreshPromise({ ...p, everBad: p.everBad || bad }, places, state.totalPages) : p));\r\n      const m = /^scene (\\d+)$/.exec(v.scope);\r\n      const step = m && state.step.kind !== 'fixing' ? { kind: 'checking' as const, index: Number(m[1]) } : state.step;\r\n      return { ...base, verdicts, everBad, promises, step };\r\n    }\r\n\r\n    case 'scene.repair':\r\n      return {\r\n        ...base,\r\n        repairs: [...state.repairs, { index: ev.data.index, attempt: ev.data.attempt, failed: ev.data.failed, because: ev.data.because }],\r\n        step: { kind: 'fixing', index: ev.data.index },\r\n      };\r\n\r\n    case 'scene.accepted': {\r\n      const page = ev.data.page;\r\n      const pages = [...state.pages.filter((p) => p.index !== page.index), page].sort((a, b) => a.index - b.index);\r\n      const attempts = { ...state.attempts, [page.index]: ev.data.attempts_used };\r\n      const all = pages.length >= state.totalPages;\r\n      return { ...base, pages, attempts, step: all ? { kind: 'painting' } : { kind: 'writing', index: page.index + 1 } };\r\n    }\r\n\r\n    case 'image.ready': {\r\n      const media = { ...state.media, [ev.data.index]: { ...state.media[ev.data.index], image: ev.data.url, imageMissing: false } };\r\n      const next = { ...base, media };\r\n      return { ...next, step: state.pages.length >= state.totalPages ? { kind: mediaStep(next) } : state.step };\r\n    }\r\n\r\n    case 'audio.ready': {\r\n      const media = { ...state.media, [ev.data.index]: { ...state.media[ev.data.index], audio: ev.data.url, seconds: ev.data.seconds, audioMissing: false } };\r\n      const next = { ...base, media };\r\n      return { ...next, step: state.pages.length >= state.totalPages ? { kind: mediaStep(next) } : state.step };\r\n    }\r\n\r\n    case 'quiz.ready':\r\n      return { ...base, quiz: ev.data };\r\n\r\n    case 'degraded': {\r\n      const d = ev.data;\r\n      let media = state.media;\r\n      if (d.index && d.what === 'image') media = { ...media, [d.index]: { ...media[d.index], imageMissing: true } };\r\n      if (d.index && d.what === 'audio') media = { ...media, [d.index]: { ...media[d.index], audioMissing: true } };\r\n      const next = { ...base, media, degradations: [...state.degradations, d] };\r\n      return d.index && state.pages.length >= state.totalPages ? { ...next, step: { kind: mediaStep(next) } } : next;\r\n    }\r\n\r\n    case 'receipt':\r\n      return { ...base, receipt: ev.data, promises: finalise(state, ev.data), step: { kind: 'wrapping' } };\r\n\r\n    case 'run.finished':\r\n      return { ...base, phase: 'finished', outcome: ev.data.outcome, step: { kind: 'done' } };\r\n\r\n    case 'run.refused':\r\n      return { ...base, phase: 'refused', refusal: { reasonCode: ev.data.reason_code, message: ev.data.message, traceId: ev.data.trace_id } };\r\n\r\n    case 'error':\r\n      return { ...base, phase: 'error', error: ev.data };\r\n\r\n    default:\r\n      return base; // unknown event types are ignored: additions to the contract must never break the page\r\n  }\r\n}\r\n\r\n// ---- selectors (pure helpers the screens use) ----------------------------------------------------------------------------------\r\n\r\nexport type MediaKind = 'ready' | 'pending' | 'missing';\r\n\r\nexport function imageStatus(s: StoryState, index: number): MediaKind {\r\n  const m = s.media[index];\r\n  if (m?.image) return 'ready';\r\n  if (m?.imageMissing) return 'missing';\r\n  return s.phase === 'running' ? 'pending' : 'missing';\r\n}\r\n\r\nexport function audioStatus(s: StoryState, index: number): MediaKind {\r\n  const m = s.media[index];\r\n  if (m?.audio) return 'ready';\r\n  if (m?.audioMissing) return 'missing';\r\n  return s.phase === 'running' ? 'pending' : 'missing';\r\n}\r\n\r\nexport function isDone(s: StoryState): boolean {\r\n  return s.phase === 'finished' || s.phase === 'refused' || s.phase === 'error';\r\n}\r\n\r\n/** Pages are all here and the run is over: the child can reach the end screen. */\r\nexport function allPagesIn(s: StoryState): boolean {\r\n  return s.pages.length >= s.totalPages;\r\n}\r\n\r\nexport const REDRAW_CODES = ['too_small', 'blank', 'no_character'];\r\nexport function isRedraw(reasonCode: string | undefined): boolean {\r\n  return !!reasonCode && REDRAW_CODES.includes(reasonCode);\r\n}\r\n\r\n/** Final status of the oath for the parent: only meaningful once the receipt arrived. */\r\nexport function keptCounts(s: StoryState) {\r\n  const c = { kept: 0, keptAfterFix: 0, notKept: 0, unchecked: 0, open: 0 };\r\n  for (const p of s.promises) {\r\n    if (p.state === 'kept') c.kept++;\r\n    else if (p.state === 'kept_after_fix') c.keptAfterFix++;\r\n    else if (p.state === 'not_kept') c.notKept++;\r\n    else if (p.state === 'unchecked') c.unchecked++;\r\n    else c.open++;\r\n  }\r\n  return c;\r\n}\r\nimport { useEffect, useRef, useState } from 'react';\nimport type { Choice, Page } from '../api/types';\nimport { Btn } from '../components/Btn';\nimport { ConfirmPictures } from '../components/ConfirmPictures';\nimport { Icon } from '../components/Icon';\nimport { Pip } from '../components/Pip';\nimport { SoundToggle } from '../components/SoundToggle';\nimport { Stones } from '../components/Stones';\nimport { nowPlaying, play, say, sfx, stop, subscribePlaying } from '../lib/sound';\nimport { stepLine } from '../lib/steps';\nimport { useSettings } from '../state/settings';\nimport { useFocusHeading, type Source } from '../state/session';\nimport { audioStatus, imageStatus, isDone, type StoryState } from '../state/storyReducer';\n\n// 6.7 The story reader. Works with whatever has arrived: a page can be read before its picture or voice exists, and a page\n// whose picture or voice never comes is a calm text-only page (never an error).\n\nfunction usePlaying(url: string | undefined): boolean {\n  const [now, setNow] = useState<string | null>(nowPlaying());\n  useEffect(() => subscribePlaying(setNow), []);\n  return !!url && now === url;\n}\n\nfunction Picture({ story, page, source }: { story: StoryState; page: Page; source: Source | null }) {\n  const status = imageStatus(story, page.index);\n  const url = story.media[page.index]?.image;\n  const [broken, setBroken] = useState(false);\n  useEffect(() => setBroken(false), [url]);\n  return (\n    <figure className=\"picture\" data-status={broken ? 'missing' : status}>\n      {status === 'ready' && !broken ? (\n        <img src={url} alt={page.scenario} onError={() => setBroken(true)} />\n      ) : status === 'pending' && !broken ? (\n        <div className=\"paper-cut\" role=\"status\">\n          <Pip pose=\"bubble\" className=\"cut-pip\" />\n          <p>Pip is still painting this picture…</p>\n        </div>\n      ) : (\n        <div className=\"paper-cut\">\n          <Pip pose=\"read\" className=\"cut-pip\" />\n          <p>{story.degradations.some((d) => d.what === 'image' && d.index === page.index && /kept its picture budget|paints some pages only/.test(d.why))\n            ? 'Pip saved the paint for the big moments. Listen to this page!'\n            : 'No picture on this page. The words still tell the story!'}</p>\n        </div>\n      )}\n      {source && <img className=\"hero-sticker\" src={source.url} alt=\"\" />}\n    </figure>\n  );\n}\n\nfunction Listen({ story, page }: { story: StoryState; page: Page }) {\n  const status = audioStatus(story, page.index);\n  const url = story.media[page.index]?.audio;\n  const playing = usePlaying(url);\n  if (status === 'missing') {\n    return <p className=\"no-sound\"><Icon name=\"speaker-slash\" /> No voice on this page</p>;\n  }\n  if (status === 'pending') {\n    return <p className=\"no-sound\"><Icon name=\"speaker-high\" /> Pip is finding a voice…</p>;\n  }\n  return (\n    <Btn variant=\"sky\" icon={playing ? 'speaker-slash' : 'speaker-high'} aria-pressed={playing} quiet\n      onClick={() => (playing ? stop() : play(url!))} className=\"listen\">\n      {playing ? 'Stop' : 'Listen'}\n    </Btn>\n  );\n}\n\nfunction Waiting({ story, n }: { story: StoryState; n: number }) {\n  return (\n    <section className=\"waiting\" aria-live=\"polite\">\n      <Pip pose=\"daydream\" className=\"waiting-pip\" />\n      <h2>Page {n} is on its way!</h2>\n      <p>{stepLine(story)}</p>\n    </section>\n  );\n}\n\nexport function Reader({ story, source, startAt, onEnd, onLeave }: { story: StoryState; source: Source | null; startAt: number; onEnd(): void; onLeave(): void }) {\n  const h = useFocusHeading<HTMLHeadingElement>();\n  const { sound } = useSettings();\n  const [n, setN] = useState(startAt);\n  const [picked, setPicked] = useState<string | null>(null);\n  const [leaving, setLeaving] = useState(false);\n  const top = useRef<HTMLElement>(null);\n  const page = story.pages.find((p) => p.index === n);\n  const total = story.totalPages;\n  const mediaRef = useRef(story.media);\n  mediaRef.current = story.media;\n\n  const go = (to: number) => {\n    stop();\n    if (to > total) { onEnd(); return; }\n    if (to < 1) return;\n    sfx('page-turn');\n    setN(to);\n    setPicked(null);\n  };\n\n  // New page: scroll to the top, and read it aloud if sound is on and the voice is already here (a tap is never needed again:\n  // the first tap on Welcome unlocked audio). A voice that arrives later is only played when the child taps Listen.\n  useEffect(() => {\n    top.current?.scrollIntoView?.({ block: 'start' });\n    const audio = mediaRef.current[n]?.audio;\n    if (sound && audio) play(audio);\n    return () => stop();\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [n]);\n\n  // If the story ended without this page (it never arrived), go to the end rather than wait forever.\n  useEffect(() => { if (!page && isDone(story)) onEnd(); }, [page, story, onEnd]);\n\n  useEffect(() => {\n    const key = (e: KeyboardEvent) => {\n      if ((e.target as HTMLElement)?.closest?.('input, textarea')) return;\n      if (e.key === 'ArrowRight') go(n + 1);\n      if (e.key === 'ArrowLeft') go(n - 1);\n    };\n    window.addEventListener('keydown', key);\n    return () => window.removeEventListener('keydown', key);\n  });\n\n  const choose = (c: Choice) => {\n    setPicked(c.id);\n    stop();\n    if (c.is_correct) { sfx('star-pop'); sfx('happy-chime'); say('reader-kind'); } else { sfx('soft-boop'); say('reader-think'); }\n  };\n\n  const pickedChoice = page?.choices.find((c) => c.id === picked);\n  const hasNext = n < total;\n\n  return (\n    <main className=\"screen reader\" data-page={n}>\n      <header className=\"screen-head\">\n        <button type=\"button\" className=\"corner-btn\" onClick={() => setLeaving(true)} aria-label=\"Leave the story\"><Icon name=\"door\" /></button>\n        <Stones story={story} active={n} onPick={(i) => go(i)} />\n        <SoundToggle />\n      </header>\n\n      <h1 ref={h} tabIndex={-1} className=\"sr-only\">Page {n} of {total}</h1>\n      <article className=\"spread\" ref={top} key={n}>\n        {page ? (\n          <>\n            <section className=\"page page-left\" aria-label=\"Picture\">\n              <Picture story={story} page={page} source={source} />\n            </section>\n            <section className=\"page page-right\" aria-label=\"The story\">\n              <div className=\"plate\">\n                <p className=\"scenario\">{page.scenario}</p>\n                <Listen story={story} page={page} />\n              </div>\n              <h2 className=\"question\">{page.question}</h2>\n              <div className=\"choices\" role=\"group\" aria-label=\"Choices\">\n                {page.choices.map((c) => {\n                  const chosen = picked === c.id;\n                  const mood = chosen ? (c.is_correct ? 'kind' : 'think') : 'idle';\n                  return (\n                    <button key={c.id} type=\"button\" className=\"choice\" data-mood={mood} aria-pressed={chosen} onClick={() => choose(c)}>\n                      <span className=\"choice-badge\" aria-hidden=\"true\">\n                        {mood === 'kind' ? <Icon name=\"star\" /> : mood === 'think' ? <Icon name=\"lightbulb\" /> : <span>{c.id.toUpperCase()}</span>}\n                      </span>\n                      <span className=\"choice-text\">{c.text}</span>\n                    </button>\n                  );\n                })}\n              </div>\n              <div className=\"feedback-slot\" aria-live=\"polite\">\n                {pickedChoice && (\n                  <div className=\"feedback\" data-mood={pickedChoice.is_correct ? 'kind' : 'think'}>\n                    <Pip pose={pickedChoice.is_correct ? 'cool' : 'dizzy'} className=\"feedback-pip\" />\n                    <div>\n                      <p className=\"feedback-head\">{pickedChoice.is_correct ? 'That was a kind thing to do!' : 'Hmm, let’s think about that.'}</p>\n                      <p className=\"feedback-text\">{pickedChoice.feedback}</p>\n                    </div>\n                  </div>\n                )}\n              </div>\n              {pickedChoice && (\n                <div className=\"after-pick\">\n                  {!pickedChoice.is_correct && <p className=\"try-other\">Try the other one!</p>}\n                  <Btn big iconAfter={hasNext ? 'arrow-right' : 'star'} className=\"next-inline\" onClick={() => go(n + 1)}>{hasNext ? 'Next' : 'The end'}</Btn>\n                </div>\n              )}\n            </section>\n          </>\n        ) : (\n          <Waiting story={story} n={n} />\n        )}\n      </article>\n\n      {n > 1 && <button type=\"button\" className=\"side-arrow left\" aria-label=\"Previous page\" onClick={() => go(n - 1)}><Icon name=\"arrow-left\" /></button>}\n      {(page || hasNext) && <button type=\"button\" className=\"side-arrow right\" aria-label={hasNext ? 'Next page' : 'The end'} onClick={() => go(n + 1)}><Icon name={hasNext ? 'arrow-right' : 'star'} /></button>}\n\n      {leaving && <ConfirmPictures title=\"Leave the story?\" yesLabel=\"Yes, leave\" noLabel=\"Keep reading\" pose=\"wink\" onNo={() => setLeaving(false)} onYes={onLeave} />}\n    </main>\n  );\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"6b50464c-d21d-41df-aa38-ff51267c7d25","context":{"git_state":{"cwd":"/d/storybound/web/src","root":"/d/storybound","branch":"experiments/architecture-and-chaos","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":9,"untracked":null,"untracked_normal":10},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"hatif03/storybound","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"hatif03/storybound","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"hatif03/storybound","visibility":"public"}]}},"live_cwd":"/d/storybound/web/src","platform":"windows"}},"sourceToolAssistantUUID":"178cdfe1-7304-42af-8b7f-cad4b9eb18d5","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-vscode","cwd":"D:\\storybound\\web\\src","sessionId":"531bd6f2-4e0c-4a05-a2e1-9f902bd0eeb6","version":"2.1.296","gitBranch":"experiments/architecture-and-chaos","slug":"glimmering-splashing-ladybug"}
