}\n    fx = client.get(\"/api/fixtures\").json()\n    assert any(f[\"id\"] == \"benign/bunny-bow-carrot\" and f[\"kind\"] == \"benign\" for f in fx)","is_error":false}]},"uuid":"edcc9a40-06d6-4cf3-9252-77b1f70419b2","timestamp":"2026-10-12T12:22:11.551Z","toolUseResult":{"stdout":"5:import json\n6:import secrets\n7:import shutil\n8:import threading\n12:from fastapi import FastAPI, File, Form, HTTPException, Request, UploadFile\n13:from fastapi.exceptions import RequestValidationError\n14:from fastapi.responses import FileResponse, JSONResponse, Response, StreamingResponse\n15:from fastapi.staticfiles import StaticFiles\n45:def err(status: int, code: str, message: str) -> JSONResponse:\n35:def test_reference_endpoints(client):\n45:def test_create_and_stream(client):\n56:def test_validation_errors_are_calm_json(client):\n70:def test_upload_accepted(client):\n79:def test_busy_when_slots_full(client, monkeypatch):\n\"\"\"API tests: the pipeline is stubbed so no network is touched.\"\"\"\n\nfrom __future__ import annotations\n\nimport io\nimport json\n\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom PIL import Image\n\nfrom storybound import api, pipeline\n\n\n@pytest.fixture\ndef client(monkeypatch):\n    def fake_execute(run):\n        run.emit(\"run.started\", {\"story_id\": run.story_id})\n        run.emit(\"character.ready\", {\"card\": {\"name\": \"Benny\"}})\n        run.emit(\"run.finished\", {\"outcome\": \"shipped\", \"story_id\": run.story_id})\n        run.bus.close()\n        return run\n\n    monkeypatch.setattr(api, \"execute\", fake_execute)\n    api.RUNS.clear()\n    return TestClient(api.app)\n\n\ndef png() -> bytes:\n    b = io.BytesIO()\n    Image.new(\"RGB\", (200, 200), \"white\").save(b, \"PNG\")\n    return b.getvalue()\n\n\ndef test_reference_endpoints(client):\n    assert client.get(\"/api/health\").json()[\"ok\"] is True\n    ls = client.get(\"/api/lessons\").json()\n    assert {x[\"id\"] for x in ls} == {\"sharing\", \"honesty\