["variable"]},{"required":["dimension"]},{"required":["data_type"]},{"required":["items"]},{"required":["time"]},{"required":["breakdown"]},{"required":["when"]},{"required":["filter"]},{"required":["branches"]},{"required":["formula"]},{"required":["default_formulas"]},{"required":["child_defaults"]},{"required":["rollup"]},{"required":["new"]},{"required":["format"]},{"required":["clear_formula"]},{"required":["children"]},{"required":["role"]},{"required":["grain"]},{"required":["sort"]},{"required":["summary"]},{"required":["members"]},{"required":["formulas"]},{"required":["property"]},{"required":["preserve"]},{"required":["inherit"]}]}}},{"if":{"required":["branches"]},"then":{"not":{"anyOf":[{"required":["target"]},{"required":["ref"]}]}}}],"if":{"anyOf":[{"required":["space"]},{"required":["branches"]},{"$ref":"#/$defs/schema155"}]},"oneOf":[{"required":["variable"]},{"required":["dimension"]},{"required":["time"]},{"required":["formulas"]},{"required":["space"]},{"required":["branches"]},{"required":["property"]},{"required":["preserve"]},{"$ref":"#/$defs/schema155"},{"not":{"anyOf":[{"required":["variable"]},{"required":["dimension"]},{"required":["time"]},{"required":["formulas"]},{"required":["space"]},{"required":["branches"]},{"required":["property"]},{"required":["preserve"]},{"anyOf":[{"$ref":"#/$defs/schema50"},{"$ref":"#/$defs/schema51"}]}]},"required":["presentation"]}],"properties":{"branches":{"$ref":"#/$defs/breakdownBranches"},"breakdown":{"description":"Levels nested beneath this variable, outermost first, as on create. Each level may declare its dimension with items and data_type and carry the sort of the axis it creates; children is the same nesting in saved-node form.","items":{"$ref":"#/$defs/breakdownNode"},"maxItems":10,"type":"array"},"child_defaults":{"$ref":"#/$defs/childDefaults","description":"Dated actuals and forecast rules this variable's breakdown children inherit, saved with the layout for a new or existing variable; an entry may name any breakdown level, so one create row carries a total's rule and its leaf rule. formula and clear update the saved row."},"children":{"items":{"description":"A saved child node. It uses the same fields recursively; the complete recursive contract is checked before execution.","type":"object"},"type":"array"},"clear_formula":{"$ref":"#/$defs/clearAxisFormula","enum":[true]},"data_type":{"$ref":"#/$defs/nodeDataType"},"default_formulas":{"$ref":"#/$defs/savedDefaultFormulasEdit"},"details":{"type":["object","null"]},"dimension":{"description":"A dimension node shows members, by name or inspected reference, so the entry carries dimension and display settings: a breakdown lists the dimension's items, and the value axis of a record table shows the item each key row is mapped to. A saved Date axis reads as a dimension with its grain. A name matching one dimension reuses it; an unmatched name creates it here with data_type and items when given; items also extend an existing dimension. A value other tables break down by is a dimension; a value you calculate with is a variable.","pattern":"\\S","type":"string"},"display_name":{"type":"string"},"filter":{"$ref":"#/$defs/breakdownFilter","description":"Visible members of a dimension this node declares or places. On a retained node, members is the saved filter; a node takes one of the two."},"format":{"additionalProperties":false,"description":"Initial style for this node's row or column, applied in the same save. Retained nodes keep their saved styles unless a field is given here.","properties":{"bg":{"description":"Background color: purple, teal, orange, yellow, red, pink, blue, green, yellow green, cyan, azure, indigo, or magenta. Corresponding DC1-DC13 tokens are also accepted, ignoring case. null, default, or DC0 clears this scope's fill and reveals inherited styling.","type":["string","null"]},"bold":{"$ref":"#/$defs/schema48"},"decimalPlaces":{"description":"Displayed decimal places. null clears this scope's override and reveals inherited formatting; omission preserves it.","maximum":5,"minimum":0,"type":["integer","null"]},"indent":{"description":"Row indentation from 0 to 8. Applies only to row targets. null clears the row's local setting; omission preserves it.","maximum":8,"minimum":0,"type":["integer","null"]},"italic":{"$ref":"#/$defs/schema48"},"numberFormat":{"description":"Number display format. null clears this scope's override and reveals inherited formatting; omission preserves it.","enum":["AUTO","NUMBER","CURRENCY","PERCENTAGE","INTEGER","MULTIPLE",null],"type":["string","null"]},"strike":{"$ref":"#/$defs/schema48"},"underline":{"$ref":"#/$defs/schema48"}},"type":"object"},"formula":{"anyOf":[{"$ref":"#/$defs/nodeFormula"},{"type":"null"}],"description":"The timeless default expression of the selected calculated value, including a dimension shown as a value or a variable enclosing or opposite a dimension axis. This edits the calculated value's rule; a pure member-list axis cannot author a generated-member formula. Source-linked dimensions offer that authoring path to the person in the row-header menu: More settings, then Edit dimension formula. On a retained target, copied null is readback absence evidence and preserves the current default; clear_formula:true removes the owned rule. For new declarations, a supplied formula must be a string."},"formulas":{"description":"Selects a saved table's formula-column group, the axis node that holds its formula columns, when a reshape layout places it. A create column names what it shows: variable, dimension, or time.","enum":[true],"type":"boolean"},"grain":{"enum":["NO_GRANULARITY","DAY","WEEK","MONTH","QUARTER","HALF","YEAR"],"type":["null","string"]},"hidden":{"allOf":[{"$ref":"#/$defs/hidden"}],"type":"boolean"},"hidden_by":{"description":"Read-only hidden ancestor that hides this node; writes ignore it.","type":"string"},"inherit":{"type":"boolean"},"items":{"$ref":"#/$defs/schema30"},"members":{"items":{"type":"string"},"type":["null","array"]},"new":{"description":"Create another variable with this name even when an existing variable already carries it. Within this request's layout the name then means the new variable; the existing ones stay reachable by their tokens.","type":"boolean"},"presentation":{"$ref":"#/$defs/read_presentation"},"preserve":{"$ref":"#/$defs/reference_address"},"property":{"$ref":"#/$defs/reference_address"},"ref":{"description":"The saved node to keep, as target; a read prints it under this name.","pattern":"\\S","type":"string"},"role":{"enum":["DIMENSION","VARIABLE"],"type":["null","string"]},"rollup":{"description":"How this new row's variable summarizes its base periods at each of quarter, half-year, and year that is coarser than the base grain, saved with the layout for Actuals and Forecast. SUM adds flows, LAST reads the final base period for a balance, and AVERAGE takes the mean. The receipt names each grain written, or an omitted rollup's default; set_time_rollup changes a saved rollup.","enum":["SUM","LAST","AVERAGE"],"type":"string"},"sort":{"$ref":"#/$defs/axis_sort"},"space":{"description":"An empty row slot with no property: a blank separator row on create, or a saved slot kept for a later fill on reshape. A new property node needs no space.","enum":[true],"type":"boolean"},"summary":{"$ref":"#/$defs/summary"},"target":{"description":"The saved node to keep, by the same selector a cell write takes: the row or column ref a read or receipt printed (Revenue#7e), its nested label (Revenue[Country]), the variable or dimension it shows (Revenue#6, Country), or a member row of its breakdown (Revenue[United States]#d), which names the breakdown axis. Two placements of one variable are told apart by their refs. With variable or dimension the node keeps that object and may change settings and children. Formula fields select a calculated value: a retained dimension breakdown uses its enclosing variable and a dimension axis opposite one variable scopes that variable, and a dimension shown as a value uses the mapping/formula owner. A member-list axis with no calculated value on either side has no formula authoring operation; dimensions add_items, remove_items, replace_items, and rename_items edit saved membership; alone, the node is kept exactly as saved. Absent on a new node.","pattern":"\\S","type":"string"},"time":{"description":"Declares a system Date axis at this reporting grain; the dimension is created when the model has none.","enum":["DAY","WEEK","MONTH","QUARTER","HALF","YEAR"],"type":"string"},"variable":{"description":"The variable shown, by name or inspected reference. Unambiguous existing names reuse that object, including from another table; unmatched names create it. default_formulas and child_defaults on the row are saved with the layout for a new or an existing variable; a timeless formula on an existing variable is an update on an undated row. On a retained reshape node, supplied formulas edit its defaults and omission preserves them. new:true creates another namesake. Ambiguous names return candidates. Shows a shared variable's values, which may be numbers, text, or dates.","pattern":"\\S","type":"string"},"when":{"$ref":"#/$defs/breakdownCondition"}},"then":{"not":{"anyOf":[{"required":["children"]},{"required":["role"]},{"required":["grain"]},{"required":["sort"]},{"required":["summary"]},{"required":["members"]}]}},"type":"object"},"scenario":{"description":"Defaults to the scenario in view, which can change between turns.","type":["string","null"]},"schema1":{"enum":["NO_GRANULARITY","DAY","WEEK","MONTH","QUARTER","HALF","YEAR"],"type":"string"},"schema10":{"properties":{"clear_formula":{"$ref":"#/$defs/schema8"}},"required":["clear_formula"]},"schema102":{"not":{"$ref":"#/$defs/schema43"},"required":["dimension"]},"schema103":{"not":{"$ref":"#/$defs/schema46"},"required":["variable"]},"schema104":{"enum":["NO_GRANULARITY"]},"schema105":{"properties":{"granularity":{"$ref":"#/$defs/schema104"}},"required":["granularity"],"type":"object"},"schema108":{"not":{"$ref":"#/$defs/schema45"}},"schema109":{"enum":["VALUE","DELTA","PERCENT"],"type":"string"},"schema111":{"items":{"$ref":"#/$defs/schema19"},"type":["null","array"]},"schema112":{"additionalProperties":false,"properties":{"measures":{"$ref":"#/$defs/schema111"},"period_offset":{"maximum":2147483647,"minimum":-2147483648,"type":"integer"}},"required":["period_offset"],"type":["null","object"]},"schema114":{"items":{"$ref":"#/$defs/reference_address"},"type":"array"},"schema115":{"anyOf":[{"$ref":"#/$defs/schema114"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"schema117":{"additionalProperties":{"type":"boolean"},"not":{"$ref":"#/$defs/schema21"},"propertyNames":{"$ref":"#/$defs/address"},"type":"object"},"schema118":{"anyOf":[{"$ref":"#/$defs/schema117"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"schema12":{"enum":["AUTO","NUMBER","CURRENCY","PERCENTAGE","INTEGER","MULTIPLE"],"type":"string"},"schema123":{"additionalProperties":false,"properties":{"end":{"type":"string"},"start":{"type":"string"},"type":{"$ref":"#/$defs/schema22"}},"required":["type","start","end"],"type":"object"},"schema124":{"anyOf":[{"$ref":"#/$defs/schema123"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"schema13":{"additionalProperties":false,"properties":{"item":{"type":"string"},"name":{"$ref":"#/$defs/address"}},"required":["item","name"],"type":"object"},"schema130":{"enum":["rows","columns"],"type":"string"},"schema139":{"required":["start"]},"schema14":{"required":["add_items"]},"schema140":{"required":["end"]},"schema149":{"properties":{"formula":{"$ref":"#/$defs/schema8"}},"required":["formula"]},"schema15":{"required":["remove_items"]},"schema151":{"properties":{"default_formulas":{"$ref":"#/$defs/schema8"}},"required":["default_formulas"]},"schema152":{"items":{"not":{"$ref":"#/$defs/schema43"},"required":["dimension"]},"maxItems":1,"minItems":1},"schema153":{"properties":{"granularity":{"enum":["NO_GRANULARITY"]}},"required":["granularity"],"type":"object"},"schema155":{"anyOf":[{"required":["target"]},{"required":["ref"]}],"not":{"$ref":"#/$defs/schema49"}},"schema156":{"anyOf":[{"required":["variable"]},{"allOf":[{"$ref":"#/$defs/schema52"}],"required":["dimension"]}],"properties":{"variable":{"minLength":1,"type":"string"}}},"schema16":{"required":["rename_items"]},"schema18":{"additionalProperties":{"type":"boolean"},"not":{"required":["inherit"]},"propertyNames":{"$ref":"#/$defs/address"},"type":"object"},"schema19":{"enum":["CURRENT","COMPARISON_VALUE","DELTA","PERCENT"],"type":"string"},"schema2":{"description":"Validates structure, references, and formula syntax without writing; returns valid, warnings, and model_effects. No values come back, since calculation does not run, and cycles go undetected. A reshape dry run previews deleting a home-owned row or column; deleting the whole table takes no dry_run.","type":["boolean","null"]},"schema20":{"additionalProperties":false,"properties":{"display_name":{"type":"string"},"presentation":{"$ref":"#/$defs/read_presentation"},"ref":{"$ref":"#/$defs/address"},"url":{"type":"string"}},"required":["display_name"],"type":"object"},"schema21":{"required":["inherit"]},"schema22":{"enum":["ABSOLUTE"],"type":"string"},"schema24":{"anyOf":[{"description":"A page name reuses a unique match or creates a page. Omission uses the current page, or creates a page named after the table when none is usable. A new page and table commit together, and two creates in one step that name the same new page share it: one receipt says the page was created, the other that it was reused.","type":"string"},{"type":"null"}]},"schema26":{"anyOf":[{"description":"true shows every generated row and column member, including those whose values are all zero or empty in the window; false requests hiding members whose values are all zero or empty, subject to the workspace empty-result policy. Omitted, create uses the workspace default and update keeps the saved setting.","type":"boolean"},{"type":"null"}]},"schema27":{"description":"Several tables in one create, saved in list order in one change: a later table's formulas name the variables an earlier table declares, and two entries naming one new page share it. The response holds one receipt per table; a refusal of any table refuses them all and names the table. The request's scenario and dry_run apply to every entry.","items":{"$ref":"#/$defs/create_table"},"maxItems":20,"minItems":1,"type":["array","null"]},"schema28":{"enum":["DO_NOT_AGGREGATE","SUM","MAX","MIN","FIRST","LAST","ANY","COUNT"],"type":"string"},"schema29":{"additionalProperties":false,"properties":{"end":{"type":"string"},"start":{"type":"string"},"type":{"enum":["ABSOLUTE"],"type":"string"}},"required":["type","start","end"],"type":"object"},"schema3":{"anyOf":[{"items":{"type":"string"},"maxItems":10000,"type":"array"},{"maxLength":16384,"pattern":"\\S","type":"string"},{"type":"null"}],"description":"The saved member filter of the selected axis, in one of two forms. A list of member names replaces the filter, a saved condition included, and may name empty:None, the rows with no value; [] clears it. A string is a live condition the table evaluates at every calculation; it narrows the saved list. It may read a dimension mapped from the axis: Employee where Status = \"Active\". Region not in {\"West\"} keeps every named member but West; the empty member has no value, so a comparison on it is unknown and a null check inside where is what keeps it: Region where (Region = null or not (Region in {\"West\"})). Literals are quoted strings; a bare number is a reference offset, not a member; date and number members match by their saved rendered text, such as \"2026-01-01 00:00:00+00\". A member row (Total[West]) names its axis. Omission or null preserves the filter.","type":["array","string","null"]},"schema30":{"description":"Manual members to create on this dimension, new or existing, in this request. Existing members are kept.","items":{"type":"string"},"maxItems":10000,"type":"array"},"schema31":{"properties":{"dimension":{"minLength":1,"type":"string"}},"required":["dimension"]},"schema32":{"properties":{"clear_formula":{"not":{"description":"any value"}},"details":{"not":{"description":"any value"}},"display_name":{"not":{"description":"any value"}},"formulas":{"not":{"description":"any value"}},"presentation":{"not":{"description":"any value"}},"preserve":{"not":{"description":"any value"}},"property":{"not":{"description":"any value"}},"protected":{"not":{"description":"any value"}},"ref":{"not":{"description":"any value"}},"target":{"not":{"description":"any value"}}}},"schema33":{"required":["variable"]},"schema34":{"required":["time"]},"schema35":{"required":["breakdown"]},"schema36":{"required":["branches"]},"schema37":{"required":["when"]},"schema38":{"required":["filter"]},"schema39":{"required":["formula"]},"schema4":{"anyOf":[{"enum":["DIMENSION","VARIABLE"],"type":"string"},{"$ref":"#/$defs/inherit"},{"type":"null"}],"description":"How the saved axis is used, DIMENSION or VARIABLE. Not a formula role: those are written with formula, default_formulas, and child_defaults."},"schema40":{"required":["default_formulas"]},"schema41":{"required":["child_defaults"]},"schema42":{"required":["rollup"]},"schema43":{"anyOf":[{"$ref":"#/$defs/schema33"},{"$ref":"#/$defs/schema34"},{"$ref":"#/$defs/schema35"},{"$ref":"#/$defs/schema36"},{"$ref":"#/$defs/schema37"},{"$ref":"#/$defs/schema38"},{"$ref":"#/$defs/schema39"},{"$ref":"#/$defs/schema40"},{"$ref":"#/$defs/schema41"},{"$ref":"#/$defs/schema42"}]},"schema44":{"required":["dimension"]},"schema45":{"required":["space"]},"schema46":{"anyOf":[{"$ref":"#/$defs/schema44"},{"$ref":"#/$defs/schema34"},{"$ref":"#/$defs/schema35"},{"$ref":"#/$defs/schema36"},{"$ref":"#/$defs/schema37"},{"$ref":"#/$defs/schema38"},{"$ref":"#/$defs/schema45"}]},"schema48":{"description":"true sets this style at this scope; false or null clears this scope's setting so broader scopes apply; omitted, it stays unchanged.","type":["boolean","null"]},"schema49":{"anyOf":[{"required":["variable"]},{"required":["dimension"]},{"required":["time"]},{"required":["formulas"]},{"required":["space"]},{"required":["branches"]},{"required":["property"]},{"required":["preserve"]}]},"schema5":{"properties":{"clear_formula":{"not":{"type":"null"}}},"required":["clear_formula"]},"schema50":{"required":["target"]},"schema51":{"required":["ref"]},"schema52":{"anyOf":[{"$ref":"#/$defs/schema50"},{"$ref":"#/$defs/schema51"}]},"schema53":{"enum":[true]},"schema54":{"additionalProperties":false,"properties":{"force":{"type":"boolean"},"target":{"$ref":"#/$defs/address"}},"required":["target"],"type":"object"},"schema6":{"properties":{"default_formulas":{"not":{"type":"null"}}},"required":["default_formulas"]},"schema67":{"required":["name"]},"schema7":{"properties":{"child_defaults":{"not":{"type":"null"}}},"required":["child_defaults"]},"schema71":{"anyOf":[{"type":"boolean"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"schema8":{"not":{"type":"null"}},"schema86":{"properties":{"dimensions":{"minItems":1,"type":"array"}},"required":["dimensions"]},"schema89":{"properties":{"row_updates":{"minItems":1,"type":"array"}},"required":["row_updates"]},"schema90":{"properties":{"column_updates":{"minItems":1,"type":"array"}},"required":["column_updates"]},"schema91":{"properties":{"cell_updates":{"minItems":1,"type":"array"}},"required":["cell_updates"]},"schema92":{"properties":{"add_dimension_items":{"minItems":1,"type":"array"}},"required":["add_dimension_items"]},"schema94":{"properties":{"add_dimension_items":{"type":"null"},"cell_updates":{"type":"null"},"column_updates":{"type":"null"},"format":{"type":"null"},"format_updates":{"type":"null"},"formula_breaks_hidden":{"type":"null"},"formula_groups_hidden":{"type":"null"},"formula_hidden":{"type":"null"},"grain":{"type":"null"},"hide_dimension_headers":{"type":"null"},"include_edit_rules":{"type":"null"},"name":{"type":"null"},"page":{"type":"null"},"readback":{"type":"null"},"row_updates":{"type":"null"},"show_empty_members":{"type":"null"},"structure":{"type":"null"},"values":{"type":"null"},"window":{"type":"null"}}},"schema99":{"anyOf":[{"$ref":"#/$defs/address"},{"type":"null"}],"description":"Optional saved table whose calendar view the receipt returns. The calendar itself belongs to the scenario named by scenario, the current one when omitted."},"sources":{"description":"The date column a source query's rows sit on, saved as preferred_time_property on every variable and dimension of that source in this write except the ones a variables or dimensions entry sets itself; target is the query reference a read prints under sources, and the column is one of the source's date columns.","items":{"additionalProperties":false,"properties":{"preferred_time_property":{"$ref":"#/$defs/address"},"target":{"$ref":"#/$defs/address"}},"required":["target","preferred_time_property"],"type":"object"},"maxItems":10000,"minItems":1,"type":"array"},"style":{"additionalProperties":false,"anyOf":[{"properties":{"bg":{"not":{"type":"null"}}},"required":["bg"]},{"properties":{"indent":{"not":{"type":"null"}}},"required":["indent"]},{"properties":{"decimalPlaces":{"not":{"type":"null"}}},"required":["decimalPlaces"]},{"properties":{"numberFormat":{"not":{"type":"null"}}},"required":["numberFormat"]},{"properties":{"dateFormat":{"not":{"type":"null"}}},"required":["dateFormat"]},{"properties":{"reset":{"not":{"type":"null"}}},"required":["reset"]},{"properties":{"bold":{"not":{"type":"null"}}},"required":["bold"]},{"properties":{"italic":{"not":{"type":"null"}}},"required":["italic"]},{"properties":{"underline":{"not":{"type":"null"}}},"required":["underline"]},{"properties":{"strike":{"not":{"type":"null"}}},"required":["strike"]}],"description":"Saved style changes. Omission preserves a field; {\"inherit\":true} removes its owned override; a text style (bold, italic, underline, strike) takes true to set and false to remove the override. reset:true removes the selected owned style.","properties":{"bg":{"anyOf":[{"type":"string"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"bold":{"type":["boolean","null"]},"dateFormat":{"anyOf":[{"enum":["ABBREVIATED","ISO","FULL_MONTH","COMPRESSED","YEAR_FIRST_SLASH","PERIOD_SEPARATED","DAY_FIRST_FORMAL","DESCRIPTIVE"],"type":"string"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"decimalPlaces":{"anyOf":[{"maximum":5,"minimum":0,"type":"integer"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"indent":{"anyOf":[{"minimum":0,"type":"integer"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"italic":{"type":["boolean","null"]},"numberFormat":{"anyOf":[{"$ref":"#/$defs/schema12"},{"$ref":"#/$defs/inherit"},{"type":"null"}]},"reset":{"enum":[true,null],"type":["boolean","null"]},"strike":{"type":["boolean","null"]},"underline":{"type":["boolean","null"]}},"type":"object"},"summary":{"description":"NONE keeps modeled parent; others combine children independently of time rollup","enum":["NONE","SUM","AVG","MIN","MAX","COUNT","LAST"],"type":"string"},"target":{"anyOf":[{"$ref":"#/$defs/address"},{"type":"null"}]},"values":{"additionalProperties":false,"description":"Literal inputs: columns and each row's first entry are single coordinate strings in the readback grammar, excluding predicates and period_range. Targets may be rows or columns inserted or declared in this request. Remaining entries give one value per column. Dated inputs leave the display window unchanged; window sets the displayed dates, and a new table's Date columns cover only dates inside it. A value saves a rule at its cell coordinates; edit_integrations ingest_csv saves a CSV as a data source. For a timeless row with one value column, these are the row's own coordinates and the value replaces its formula. null leaves its cell as it is; clear_formula in cell_updates removes a saved value.","properties":{"columns":{"items":{"$ref":"#/$defs/address"},"minItems":1,"type":"array"},"rows":{"items":{"items":{"type":["string","number","boolean","null"]},"minItems":2,"prefixItems":[{"$ref":"#/$defs/address"}],"type":"array"},"minItems":1,"type":"array"}},"required":["columns","rows"],"type":["null","object"]},"window_2":{"anyOf":[{"$ref":"#/$defs/schema29"},{"$ref":"#/$defs/inherit"},{"type":"null"}]}},"additionalProperties":false,"description":"Fill exactly one action block: copy, create, delete, reshape, set_time_rollup, update, update_calendar. Fields beside the block apply to it: scenario."},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__cfoai__inspect_documentation","description":"Input constraint: Provide parameters for at least one of: (search) or (read) or (question).\n\nSearches and reads published cfo.ai product documentation. Use search to find relevant passages, then read a returned target for the complete page when exact steps, surrounding context, or page contents are needed. Search context is an excerpt, not the full page. Read returns complete:true only with the entire page. Choose one operation per call. Built-in skills, workspace data, and calculated financial results have their own tools. An available:false result leaves product claims unverified.","input_schema":{"type":"object","properties":{"_context":{"additionalProperties":false,"description":"Optional active scenario, page, and time zone.","properties":{"layerId":{"description":"Active scenario ID.","type":"string"},"pageId":{"description":"Active page ID.","type":"string"},"timeZone":{"description":"Time zone, such as America/New_York.","type":"string"},"utcOffset":{"description":"UTC offset, such as -04:00.","type":"string"}},"type":"object"},"org_id":{"description":"Workspace ID or slug. Optional when you belong to one workspace. Otherwise, call list_orgs and choose an ID or slug. Numbers always identify workspace IDs.","type":["string","number"]},"question":{"description":"Compatibility form for existing search callers. New calls use the search block.","pattern":"\\S","type":["string","null"]},"read":{"additionalProperties":false,"description":"Read one complete documentation page, including context beyond matching search passages.","properties":{"target":{"description":"Copy a target from search results, or supply an https://docs.cfo.ai page URL.","pattern":"\\S","type":"string"}},"required":["target"],"type":["object","null"]},"search":{"additionalProperties":false,"description":"Find relevant passages and reusable page targets.","properties":{"question":{"description":"The product or how-to question, in full.","pattern":"\\S","type":"string"}},"required":["question"],"type":["object","null"]}},"required":[],"additionalProperties":false},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__cfoai__inspect_history","description":"Input constraint: Provide parameters for exactly one of: (changelog) or (changes_between_points) or (read) or (scenario_summary).\n\nReads scenario history: the changelog, the net difference between two points in time, and the changes a scenario would merge into its parent. A diff is not a complete historical snapshot. Entries name their scenario, actor, and operations; a scenario's changelog also shows changes it inherited from Main. Failed or skipped operations show up only when the product recorded them. read without sections returns the changelog.","input_schema":{"type":"object","properties":{"_context":{"additionalProperties":false,"description":"Optional active scenario, page, and time zone.","properties":{"layerId":{"description":"Active scenario ID.","type":"string"},"pageId":{"description":"Active page ID.","type":"string"},"timeZone":{"description":"Time zone, such as America/New_York.","type":"string"},"utcOffset":{"description":"UTC offset, such as -04:00.","type":"string"}},"type":"object"},"changelog":{"additionalProperties":false,"properties":{"before":{"$ref":"#/$defs/schema11"},"include_details":{"