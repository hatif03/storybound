ype":"external","entrypoint":"claude-vscode","cwd":"D:\\storybound","sessionId":"531bd6f2-4e0c-4a05-a2e1-9f902bd0eeb6","version":"2.1.296","gitBranch":"experiments/architecture-and-chaos","slug":"glimmering-splashing-ladybug"}
