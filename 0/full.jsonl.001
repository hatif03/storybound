"#/$defs/format"},"format_updates":{"$ref":"#/$defs/format_updates"},"formula_breaks_hidden":{"$ref":"#/$defs/formula_breaks_hidden"},"formula_groups_hidden":{"$ref":"#/$defs/formula_groups_hidden"},"formula_hidden":{"$ref":"#/$defs/formula_hidden"},"grain":{"$ref":"#/$defs/grain"},"hide_dimension_headers":{"$ref":"#/$defs/hide_dimension_headers"},"include_edit_rules":{"$ref":"#/$defs/include_edit_rules"},"layout":{"additionalProperties":false,"description":"Complete ordered rows and columns. Omitted nodes leave this layout, except an object's home-table node; [] clears a side. Retained nodes carry their complete inspected definitions. New nodes use the create grammar and are created and placed in this save, on either side under new or existing parents. Omitted settings, comparison and preserved remain unchanged. Shared variable and dimension settings are edited with update's variables and dimensions.","properties":{"breakdowns":{"items":{"additionalProperties":false,"description":"One concrete row's saved breakdown. under is its full inspected parent row; root is the one node nested there, using the same saved-node fields. ref/target is absent only when creating an entry. Other item entries and legacy interiors remain separate owners.","properties":{"display_name":{"type":"string"},"presentation":{"$ref":"#/$defs/read_presentation"},"ref":{"$ref":"#/$defs/address"},"root":{"$ref":"#/$defs/saved_table_node"},"target":{"$ref":"#/$defs/address"},"under":{"$ref":"#/$defs/reference_address"}},"required":["under","root"],"type":"object"},"type":"array"},"columns":{"items":{"allOf":[{"$ref":"#/$defs/saved_table_node"},{"$ref":"#/$defs/schema108"}]},"type":"array"},"comparison":{"additionalProperties":false,"description":"Scenario or period comparison. Omitted or null keeps the saved comparison; an object replaces it, and {} clears both kinds.","properties":{"layout":{"enum":["COLUMNS","ROWS"],"type":["null","string"]},"measures":{"items":{"$ref":"#/$defs/schema109"},"type":["null","array"]},"scenarios":{"description":"Scenario names or references returned by inspect_scenarios. Each scenario must be readable. Old table-owned comparison references can preserve an already saved entry only.","items":{"$ref":"#/$defs/reference_address"},"type":["null","array"]},"time":{"$ref":"#/$defs/schema112"}},"type":["null","object"]},"partial":{"type":"boolean"},"preserved":{"description":"References that a read lists for opaque legacy entries and for saved setting overrides. Accepted so a copied read can be sent back unchanged; it changes nothing, because omitted entries and settings are already kept.","items":{"anyOf":[{"$ref":"#/$defs/address"},{"$ref":"#/$defs/schema20"}]},"type":["null","array"]},"preserved_details":{"additionalProperties":{"type":["object","null"]},"type":"object"},"remove":{"description":"Inspected references of opaque legacy item breakdowns to remove. Entries not listed here stay saved. An editable breakdown is removed by leaving it out of breakdowns.","items":{"$ref":"#/$defs/address"},"type":"array"},"rows":{"items":{"$ref":"#/$defs/saved_table_node"},"maxItems":100,"type":"array"},"settings":{"additionalProperties":false,"description":"Local table settings. Each omitted field keeps its saved override, {\"inherit\":true} releases that field to the scenario's inherited value, and a value sets it; {} keeps every setting. Top-level window, grain, and other setting fields beside layout fill omitted fields here; two different explicit values are refused. Saved widths stay unchanged. inherited_settings from a read is separate, read-only evidence.","properties":{"formula_breaks_hidden":{"$ref":"#/$defs/schema115"},"formula_groups_hidden":{"$ref":"#/$defs/schema118"},"formula_hidden":{"$ref":"#/$defs/schema71"},"grain":{"$ref":"#/$defs/grain"},"hide_dimension_headers":{"$ref":"#/$defs/schema71"},"show_empty_members":{"$ref":"#/$defs/schema71"},"window":{"$ref":"#/$defs/schema124"}},"type":["null","object"]}},"required":["rows","c