{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-34-237-142-143.compute-1.amazonaws.com/api/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "http://ec2-34-237-142-143.compute-1.amazonaws.com/videos/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}