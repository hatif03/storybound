ith exactly one point type. Absence selects the current state.","oneOf":[{"required":["change_log_id"]},{"required":["timestamp"]},{"required":["relative_duration"]},{"required":["calendar_boundary"]}],"properties":{"calendar_boundary":{"description":"A local calendar period boundary in the user's runtime timezone, for phrases such as \"yesterday\" or \"last month\"; UTC when no timezone is known.","properties":{"boundary":{"enum":["start","end"],"type":"string"},"offset":{"description":"0 is the current period, -1 the previous, 1 the next.","type":"integer"},"unit":{"description":"Weeks start on Monday.","enum":["day","week","month","quarter","year"],"type":"string"}},"required":["unit","offset","boundary"],"type":"object"},"change_log_id":{"description":"Exact or approximate changelog point. The backend resolves to this workspace's latest changelog at or before this ID.","minimum":0,"type":"integer"},"relative_duration":{"description":"A duration from now, such as \"a couple hours ago\" or \"a day from now\"; a day is 24 hours and a week is seven days.","properties":{"amount":{"minimum":1,"type":"integer"},"direction":{"enum":["ago","from_now"],"type":"string"},"unit":{"enum":["minute","hour","day","week"],"type":"string"}},"required":["amount","unit","direction"],"type":"object"},"timestamp":{"description":"Exact instant supplied by the user, runtime context, or a tool result, as RFC3339 or RFC3339Nano with a timezone.","type":"string"}},"type":"object"},"list":{"additionalProperties":false,"properties":{"after":{"description":"The previous result's next.after value; the list continues after that page, under the same scenario and target.","type":"string"},"limit":{"description":"Maximum page summaries to return; the default is 25.","maximum":100,"minimum":1,"type":"integer"},"scenario":{"$ref":"#/$defs/scenario"},"target":{"$ref":"#/$defs/schema1"}},"type":"object"},"org_id":{"description":"Workspace ID or slug. Optional when you belong to one workspace. Otherwise, call list_orgs and choose an ID or slug. Numbers always identify workspace IDs.","type":["string","number"]},"read":{"additionalProperties":false,"properties":{"contains":{"description":"Text to find, ignoring case. Each page comes back with only the text blocks whose text contains it, each with its Markdown, ref, and target; tables and other blocks are left out.","type":"string"},"include_text":{"description":"Adds each text block's content as Markdown, the form edit_pages add_text and update_text take.","type":"boolean"},"scenario":{"$ref":"#/$defs/scenario"},"target":{"allOf":[{"anyOf":[{"$ref":"#/$defs/schema2"},{"contains":{"pattern":"\\S","type":"string"},"items":{},"type":"array"}]}],"description":"Pages to read by name or a returned qualified target. A name matching nothing does not fail the call: the pages that exist are returned, and unmatched names are listed in a trailing unresolved entry.","items":{"pattern":"\\S","type":"string"},"maxItems":50,"minItems":1,"pattern":"\\S","type":["string","array"]}},"required":["target"],"type":"object"},"scenario":{"description":"Scenario to use. Defaults to the scenario in view, which can change between turns.","type":["string","null"]}},"required":[],"$defs":{"scenario":{"description":"Scenario to use. Defaults to the scenario in view, which can change between turns.","type":["string","null"]},"schema1":{"description":"Page names or returned qualified targets to list. An absent or empty list includes every page. Unmatched names appear in unresolved_page_names without failing the call. Named pages follow resolution order, not sidebar order.","items":{"pattern":"\\S","type":"string"},"maxItems":50,"pattern":"\\S","type":["string","array"]},"schema2":{"anyOf":[{"pattern":"\\S","type":"string"},{"type":"number"},{"type":"boolean"}]}},"additionalProperties":false,"description":"Fill exactly one action block: list, read. Fields beside the block apply to it: as_of_point, scenario."},"eager_input_streaming":true,"defer_loading":true},{"name":"mcp__cfoai__inspect_scenarios","description":"Input constraint: Provide parameters for exactly one of: (list) or (read) or (subtree).\n\nReads workspace scenarios: their ownership, snapshots, and editable descendant trees, without changing anything. list returns the visible scenarios; lockedAtChangeLogId marks a snapshot pinned at that entry; it no longer inherits changes or integration syncs, but edits to it still save. next_after continues a page, and as_of_point holds paging on one snapshot. read without sections returns the scenario list.","input_schema":{"type":"object","properties":{"_context":{"additionalProperties":false,"description":"Optional active scenario, page, and time zone.","properties":{"layerId":{"description":"Active scenario ID.","type":"string"},"pageId":{"description":"Active page ID.","type":"string"},"timeZone":{"description":"Time zone, such as America/New_York.","type":"string"},"utcOffset":{"description":"UTC offset, such as -04:00.","type":"string"}},"type":"object"},"as_of_point":{"anyOf":[{"description":"Optional snapshot with exactly one point type. Absence selects the current state.","oneOf":[{"required":["change_log_id"]},{"required":["timestamp"]},{"required":["relative_duration"]},{"required":["calendar_boundary"]}],"properties":{"calendar_boundary":{"description":"A local calendar period boundary in the user's runtime timezone, for phrases such as \"yesterday\" or \"last month\"; UTC when no timezone is known.","properties":{"boundary":{"enum":["start","end"],"type":"string"},"offset":{"description":"0 is the current period, -1 the previous, 1 the next.","type":"integer"},"unit":{"$ref":"#/$defs/schema1"}},"required":["unit","offset","boundary"],"type":"object"},"change_log_id":{"description":"Exact or approximate changelog point. The backend resolves to this workspace's latest changelog at or before this ID.","minimum":0,"type":"integer"},"relative_duration":{"$ref":"#/$defs/schema2"},"timestamp":{"descrip