efore the end of history carries the before value that continues the search.","type":["string","null"]},"schema3":{"description":"A duration from now, such as \"a couple hours ago\" or \"a day from now\"; a day is 24 hours and a week is seven days.","properties":{"amount":{"minimum":1,"type":"integer"},"direction":{"enum":["ago","from_now"],"type":"string"},"unit":{"enum":["minute","hour","day","week"],"type":"string"}},"required":["amount","unit","direction"],"type":"object"},"schema32":{"anyOf":[{"pattern":"\\S","type":"string"},{"type":"number"},{"type":"boolean"}]},"schema33":{"minItems":1,"minProperties":1,"not":{"type":"null"},"pattern":"\\S"},"schema34":{"contains":{"$ref":"#/$defs/schema33"},"items":{},"type":"array"},"schema35":{"not":{"$ref":"#/$defs/schema33"}},"schema36":{"additionalProperties":{"$ref":"#/$defs/schema35"},"properties":{}},"schema39":{"not":{"pattern":"\\S","type":"string"}},"schema40":{"additionalProperties":{"$ref":"#/$defs/schema35"},"properties":{"boundary":{"$ref":"#/$defs/schema39"},"offset":{"$ref":"#/$defs/inactive_limit"},"unit":{"$ref":"#/$defs/schema39"}}},"schema43":{"additionalProperties":{"$ref":"#/$defs/schema35"},"properties":{"amount":{"$ref":"#/$defs/inactive_limit"},"direction":{"$ref":"#/$defs/schema39"},"unit":{"$ref":"#/$defs/schema39"}}},"schema53":{"additionalProperties":true,"not":{"$ref":"#/$defs/schema36"},"properties":{},"type":"object"},"schema54":{"anyOf":[{"$ref":"#/$defs/schema32"},{"$ref":"#/$defs/schema34"},{"$ref":"#/$defs/schema53"}]},"schema58":{"additionalProperties":true,"not":{"$ref":"#/$defs/schema40"},"properties":{},"type":"object"},"schema59":{"not":{"$ref":"#/$defs/schema58"}},"schema61":{"additionalProperties":true,"not":{"$ref":"#/$defs/schema43"},"properties":{},"type":"object"},"schema62":{"not":{"$ref":"#/$defs/schema61"}},"schema63":{"additionalProperties":{"$ref":"#/$defs/schema35"},"properties":{"calendar_boundary":{"$ref":"#/$defs/schema59"},"change_log_id":{"$ref":"#/$defs/inactive_li